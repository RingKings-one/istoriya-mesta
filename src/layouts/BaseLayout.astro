---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { images } from '../data';
import '../styles/global.css';
import '../styles/hero.css';

const {
  title = 'История места — Атлас живых историй',
  description = 'У каждого места есть история. Мы помогаем её почувствовать.',
} = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#181d1a" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="История места" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={images.hero} />
    <meta property="og:image:alt" content="Временный редакционный визуал проекта «История места»" />
    <meta property="og:image:width" content="2200" />
    <meta property="og:image:height" content="1465" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={images.hero} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        const targets = document.querySelectorAll(
          'main > section:not(.hero):not(.page-intro), .card-grid > .feature-card, .route-steps li'
        );

        if (!targets.length) return;

        const observer = new IntersectionObserver((entries, activeObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            activeObserver.unobserve(entry.target);
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -7% 0px',
        });

        targets.forEach((target) => {
          target.classList.add('reveal-ready');
          observer.observe(target);
        });
      })();
    </script>
  </body>
</html>
