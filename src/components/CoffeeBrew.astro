<section class="section coffee-brew" id="brew" aria-labelledby="brew-title" data-brew>
  <div class="brew-copy">
    <p class="eyebrow">ЗА СТОЙКОЙ</p>
    <h2 id="brew-title">Пока готовится <em>кофе</em></h2>
    <p>Сначала помол, затем короткая экстракция. Посмотрите, как эспрессо собирается в чашке.</p>
    <button class="button" type="button" data-brew-play data-coffee-cursor hidden>Приготовить кофе</button>
  </div>
  <figure class="brew-figure">
    <svg class="brew-drawing" aria-hidden="true" focusable="false" viewBox="0 0 420 360">
      <defs>
        <linearGradient id="brew-metal" x2="0" y2="1">
          <stop stop-color="#766047"/>
          <stop offset="1" stop-color="#3f382a"/>
        </linearGradient>
        <linearGradient id="brew-crema" x2="0" y2="1">
          <stop stop-color="#d8a975"/>
          <stop offset="1" stop-color="#814526"/>
        </linearGradient>
      </defs>
      <path class="brew-rule" d="M30 334H390M47 345H373"/>
      <g class="brew-machine">
        <path class="machine-shell" d="M75 98 91 74h236l18 24v51H75z"/>
        <path class="machine-line" d="M76 99h267M97 89h135M98 132h244"/>
        <circle class="machine-dial" cx="306" cy="115" r="8"/>
        <path class="machine-line dial-needle" d="m306 115 3-4"/>
        <circle class="brew-lamp" cx="278" cy="115" r="2.4"/>
        <path class="machine-line" d="M167 150h88l-9 18h-70z"/>
        <path class="machine-line" d="M190 168v10m38-10v10"/>
        <g class="brew-holder">
          <path d="M162 158h100l-8 13h-83z"/>
          <path d="M253 157h84l9 5-9 6h-87"/>
        </g>
      </g>
      <g class="brew-beans">
        <path d="M182 58c-8-9 2-23 12-20 10 3 3 25-12 20zm3-3c6-3 6-9 7-14"/>
        <path d="M209 53c-4-11 11-19 17-11 5 7-10 19-17 11zm3 0c7 0 8-7 11-10"/>
        <path d="M235 65c-9-6-3-21 6-20 9 1 6 19-6 20zm2-5c4-3 1-7 3-12"/>
      </g>
      <g class="brew-pour">
        <path d="M190 177c-1 28 5 53 8 83m30-83c1 28-4 58-8 83"/>
      </g>
      <g class="brew-steam">
        <path d="M196 252c-15-12 15-19 2-33m19 31c13-10-11-20-2-34"/>
      </g>
      <path class="brew-cup" d="M142 267h136l-9 32c-4 16-20 23-43 23h-35c-21 0-38-8-41-23z"/>
      <path class="brew-cup" d="M277 273h15c24 0 22 29 1 29h-24"/>
      <ellipse class="brew-rim" cx="210" cy="268" rx="67" ry="10"/>
      <ellipse class="brew-liquid" cx="210" cy="269" rx="55" ry="6.5"/>
      <path class="brew-rule" d="M125 329h171l-15 6H140z"/>
    </svg>
    <figcaption>
      <span class="brew-step grind">Помол</span>
      <span class="brew-step extract">Экстракция</span>
      <span class="brew-step serve">Эспрессо в чашке</span>
    </figcaption>
  </figure>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-brew]');
  const play = scene?.querySelector<HTMLButtonElement>('[data-brew-play]');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  let finish = 0;
  let observer: IntersectionObserver | undefined;

  function brew() {
    if (!scene || !play || motion.matches) return;
    observer?.disconnect();
    clearTimeout(finish);
    scene.classList.remove('is-brewing', 'is-served');
    void scene.offsetWidth;
    scene.classList.add('is-brewing');
    play.textContent = 'Повторить приготовление';
    finish = window.setTimeout(() => {
      scene.classList.remove('is-brewing');
      scene.classList.add('is-served');
    }, 3900);
  }

  function syncBrew() {
    if (!scene || !play) return;
    play.hidden = motion.matches;
    if (motion.matches) {
      observer?.disconnect();
      clearTimeout(finish);
      scene.classList.remove('is-brewing');
      scene.classList.add('is-served');
    }
  }

  if (scene && play) {
    syncBrew();
    play.addEventListener('click', brew);
    motion.addEventListener('change', syncBrew);
    if (!motion.matches && 'IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.intersectionRatio >= .45)) brew();
      }, { threshold: 0.45 });
      observer.observe(scene.querySelector('.brew-figure') ?? scene);
    }
  }
</script>

<style>
.coffee-brew {
  background:#242a21;
  border-block:1px solid #d4ba922c;
  grid-template-columns:minmax(0,.72fr) minmax(0,1.25fr);
  align-items:center;
  gap:clamp(25px,6vw,90px);
  scroll-margin-top:78px;
  display:grid;
}
.brew-copy h2 {
  font:400 clamp(41px, 6vw, 92px)/.93 var(--serif);
  letter-spacing:-.04em;
  margin:12px 0 22px;
}
.brew-copy h2 em {
  color:#e2bd96;
}
.brew-copy p:not(.eyebrow) {
  max-width:38ch;
  color:var(--muted);
}
.brew-copy button {
  margin-top:14px;
}
.brew-copy button[hidden] {
  display:none;
}
.brew-figure {
  background:radial-gradient(at 51% 57%,#50392560,#27251b 70%);
  border:1px solid #d8ae7852;
  min-width:0;
  margin:0;
  padding:clamp(13px,3vw,45px);
}
.brew-drawing {
  width:100%;
  max-height:460px;
  display:block;
}
.brew-machine {
  opacity:.62;
}
.machine-shell {
  fill:none;
  stroke:#c4a27a;
  stroke-width:1px;
}
.machine-line,.machine-dial {
  fill:none;
  stroke:#d7b585;
  stroke-width:1px;
}
.brew-rule {
  fill:none;
  stroke:#9e7c54;
  opacity:.55;
}
.brew-lamp {
  fill:#e1b57c;
  opacity:.35;
}
.brew-holder {
  fill:none;
  stroke:#b69264;
  stroke-width:1px;
}
.brew-beans {
  fill:none;
  stroke:#d19d71;
  stroke-width:1.1px;
  opacity:0;
}
.brew-pour,.brew-steam {
  fill:none;
  stroke-linecap:round;
}
.brew-pour {
  stroke:#db9b62;
  stroke-width:1.6px;
  opacity:0;
}
.brew-steam {
  stroke:#e6cbb0;
  stroke-width:1.1px;
  opacity:0;
}
.brew-cup {
  fill:#d9c7ae;
  stroke:#f2d6ab;
  stroke-width:1.15px;
}
.brew-rim {
  fill:#3d2920;
  stroke:#e5caa7;
}
.brew-liquid {
  fill:url(#brew-crema);
  opacity:0;
  transform-box:fill-box;
  transform-origin:50%;
}
figcaption {
  color:#d7c7b2;
  border-top:1px solid #cdad7944;
  flex-wrap:wrap;
  justify-content:center;
  gap:9px 24px;
  margin-top:15px;
  padding-top:16px;
  font-size:.83rem;
  display:flex;
}
@media (prefers-reduced-motion:no-preference) {
  .is-brewing .brew-beans {
    animation:.95s both beans-hint;
  }
  .is-brewing .brew-lamp {
    animation:.35s .7s both lamp-lit;
  }
  .is-brewing .brew-pour {
    animation:1.55s .72s both espresso-stream;
  }
  .is-brewing .brew-liquid {
    animation:2.5s .85s both crema-settle;
  }
  .is-brewing .brew-steam {
    animation:1.15s 2.45s both coffee-steam;
  }
  .is-brewing .grind {
    animation:1.15s both brew-label;
  }
  .is-brewing .extract {
    animation:1.25s .8s both brew-label;
  }
  .is-brewing .serve {
    animation:1.15s 2.45s both brew-label;
  }
  .is-served .brew-liquid {
    opacity:1;
    transform:scaleX(1);
  }
  .is-served .brew-lamp {
    opacity:1;
  }
  .is-served .brew-steam {
    opacity:.72;
    animation:3.4s ease-in-out infinite steam-breathe;
  }
  .is-served .serve {
    color:#ffe0a6;
  }
}
@media (prefers-reduced-motion:reduce) {
  .is-served .brew-liquid,.is-served .brew-steam,.is-served .brew-lamp {
    opacity:1;
  }
  .is-served .serve {
    color:#ffe0a6;
  }
}
@keyframes beans-hint {
  0%,to {
    opacity:0;
  }
  30%,62% {
    opacity:.9;
  }
}
@keyframes lamp-lit {
  0% {
    opacity:.2;
  }
  to {
    opacity:1;
  }
}
@keyframes espresso-stream {
  0% {
    opacity:0;
    stroke-dasharray:0 90;
  }
  22%,78% {
    opacity:.9;
    stroke-dasharray:90 0;
  }
  to {
    opacity:0;
  }
}
@keyframes crema-settle {
  0% {
    opacity:0;
    transform:scaleX(.12);
  }
  to {
    opacity:1;
    transform:scaleX(1);
  }
}
@keyframes coffee-steam {
  0% {
    opacity:0;
    transform:translateY(6px);
  }
  to {
    opacity:.72;
    transform:translateY(0);
  }
}
@keyframes steam-breathe {
  0%,to {
    opacity:.38;
    transform:translateY(2px);
  }
  50% {
    opacity:.82;
    transform:translateY(-3px);
  }
}
@keyframes brew-label {
  0%,to {
    color:#d7c7b2;
  }
  40%,78% {
    color:#ffe0a6;
  }
}
@media (width<=760px) {
  .coffee-brew {
    grid-template-columns:minmax(0,1fr);
  }
}
</style>
