---
import EditorialImage from './EditorialImage.astro';
import { isPlaceholderImage } from '../data';
import ArrowMark from './ArrowMark.astro';
const {
  image,
  imageAlt = '',
  eyebrow,
  title,
  text,
  href = '/cities/',
  number,
} = Astro.props;
const showPlaceholderDisclosure = isPlaceholderImage(image);
---
<a class="feature-card" href={href}>
  <div class="feature-image">
    <EditorialImage src={image} alt={imageAlt} sizes="(max-width: 420px) 100vw, (max-width: 680px) 50vw, 33vw" />
    {showPlaceholderDisclosure && <span class="feature-image-disclosure">ВРЕМЕННЫЙ ВИЗУАЛ · НЕ ДОКУМЕНТАЛЬНОЕ ФОТО</span>}
    {number && <span class="feature-number" aria-hidden="true">{number}</span>}
  </div>
  <div class="feature-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{text}</p>
    <span class="text-link">Открыть материал <ArrowMark direction="forward" /></span>
  </div>
</a>
