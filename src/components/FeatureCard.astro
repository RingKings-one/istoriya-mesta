---
import { imageSrcSet } from '../data';
const {
  image,
  imageAlt = '',
  eyebrow,
  title,
  text,
  href = '/cities/',
  number,
} = Astro.props;
---
<a class="feature-card" href={href}>
  <div class="feature-image">
    <img src={image} srcset={imageSrcSet(image)} sizes="(max-width: 420px) 100vw, (max-width: 680px) 50vw, 33vw" alt={imageAlt} loading="lazy" decoding="async" />
    <span class="feature-image-disclosure">ВРЕМЕННЫЙ ВИЗУАЛ · НЕ ДОКУМЕНТАЛЬНОЕ ФОТО</span>
    {number && <span class="feature-number" aria-hidden="true">{number}</span>}
  </div>
  <div class="feature-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{text}</p>
    <span class="text-link">Открыть материал ↗</span>
  </div>
</a>
