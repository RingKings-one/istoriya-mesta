---
import { pageJourneys, type EditorialPageKey } from '../content';

const { current } = Astro.props as { current: EditorialPageKey };
const destinations = pageJourneys[current] ?? [];
---
{destinations.length > 0 && (
  <nav class="editorial-path section" aria-label="Продолжить исследование">
    <div class="editorial-path-heading">
      <p class="eyebrow">СЛЕДУЮЩИЙ ШАГ</p>
      <h2>Продолжить исследование.</h2>
    </div>
    <div class="editorial-path-links">
      {destinations.map((destination, index) => (
        <a class="editorial-path-link" href={destination.href}>
          <span class="editorial-path-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="editorial-path-copy">
            <strong>{destination.title}</strong>
            <small>{destination.note}</small>
          </span>
          <span class="editorial-path-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </nav>
)}

<style>
  .editorial-path {
    display: grid;
    grid-template-columns: minmax(190px, .65fr) minmax(0, 1.35fr);
    gap: clamp(24px, 5vw, 72px);
    padding-top: 34px;
    padding-bottom: 72px;
    border-top: 1px solid #d7c7b244;
  }
  .editorial-path-heading h2 {
    max-width: 300px;
    margin: 12px 0 0;
    font: 400 clamp(27px, 3.4vw, 42px)/1.05 var(--serif);
  }
  .editorial-path-links { display: grid; }
  .editorial-path-link {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 22px;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 15px 0;
    border-bottom: 1px solid #d7c7b233;
    transition: padding .22s ease, color .22s ease;
  }
  .editorial-path-link:first-child { border-top: 1px solid #d7c7b233; }
  .editorial-path-link:hover { padding-left: 7px; color: var(--stone); }
  .editorial-path-number { color: var(--rust); font: 19px var(--serif); }
  .editorial-path-copy { display: grid; gap: 4px; min-width: 0; }
  .editorial-path-copy strong { font: 400 clamp(18px, 2vw, 24px)/1.15 var(--serif); }
  .editorial-path-copy small { color: var(--muted); font-size: 10px; line-height: 1.5; }
  .editorial-path-arrow { color: var(--stone); font-size: 18px; }
  @media(max-width: 680px) {
    .editorial-path { grid-template-columns: 1fr; gap: 18px; padding-bottom: 52px; }
    .editorial-path-heading h2 { max-width: 420px; }
    .editorial-path-link { grid-template-columns: 28px minmax(0, 1fr) 18px; gap: 10px; }
  }
  @media(prefers-reduced-motion: reduce) {
    .editorial-path-link { transition: none; }
  }
</style>
