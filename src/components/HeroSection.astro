---
import { images, hasLocalImage } from '../data';
import { ruzaMedia } from '../content/ruza-media';
import EditorialImage from './EditorialImage.astro';
import ArrowMark from './ArrowMark.astro';
const projectHero = hasLocalImage(images.hero);
const heroPhoto = ruzaMedia.wideCity;
---
<section class="hero hero--atlas" data-opening aria-labelledby="home-title">
  <EditorialImage className="hero-image" src={projectHero ? images.hero : heroPhoto.src} sizes="100vw" alt="" width={heroPhoto.width} height={heroPhoto.height} loading="eager" fetchpriority="high" position="right center" />

  <div class="hero-content">
    <p class="eyebrow">АТЛАС ЖИВЫХ ИСТОРИЙ</p>
    <p class="hero-chapter"><span>01</span><span class="hero-chapter-rule" aria-hidden="true"></span><span>ПЕРВАЯ ГЛАВА · РУЗА</span></p>
    <h1 id="home-title">У каждого<br />места есть<br /><em>история.</em></h1>
    <p class="lead">Мы помогаем её почувствовать.</p>
    <div class="hero-actions">
      <a class="button button-filled" href="/cities/">Открыть атлас <ArrowMark direction="forward" /></a>
      <a class="hero-secondary-link" href="/cities/ruza/">Начать с Рузы <ArrowMark direction="forward" /></a>
    </div>
  </div>

  <div class="hero-bottomline">
    {!projectHero && <p class="hero-asset-note">РУЗА · РЕЧНАЯ ДОЛИНА</p>}
    <a class="hero-scroll-cue" href="#atlas-opening">
      <span>Листать дальше</span>
      <ArrowMark direction="forward" />
    </a>
  </div>
</section>

<script>
  const chapterLink = document.querySelector<HTMLAnchorElement>('.hero-scroll-cue');
  const chapter = document.querySelector<HTMLElement>('#atlas-opening');

  chapterLink?.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;

    // WebKit can scroll to a fragment without transferring keyboard focus.
    requestAnimationFrame(() => chapter?.focus({ preventScroll: true }));
  });
</script>
