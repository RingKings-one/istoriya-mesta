---
import { images, isPlaceholderImage } from '../data';
import EditorialImage from './EditorialImage.astro';
import ArrowMark from './ArrowMark.astro';
---
<section class="hero hero--atlas" aria-labelledby="home-title">
  <EditorialImage className="hero-image" src={images.hero} sizes="100vw" alt="" loading="eager" fetchpriority="high" position="center 54%" />

  <div class="hero-content">
    <p class="eyebrow">АТЛАС ЖИВЫХ ИСТОРИЙ</p>
    <p class="hero-chapter"><span>01</span><span class="hero-chapter-rule" aria-hidden="true"></span><span>ПЕРВАЯ ГЛАВА · РУЗА</span></p>
    <h1 id="home-title">У каждого<br />места есть<br /><em>история.</em></h1>
    <p class="lead">Мы помогаем её почувствовать.</p>
    <div class="hero-actions">
      <a class="button button-filled" href="/cities/">Открыть атлас <ArrowMark direction="forward" /></a>
      <a class="hero-secondary-link" href="/cities/ruza/">Начать с Рузы <ArrowMark direction="forward" /></a>
    </div>
  </div>

  <div class="hero-side-note" aria-hidden="true">
    <span>ИСТОРИЯ</span>
    <span class="hero-side-rule"></span>
    <span>МЕСТО</span>
  </div>

  <div class="hero-bottomline">
    {isPlaceholderImage(images.hero) && <p class="hero-asset-note">ВРЕМЕННЫЙ ВИЗУАЛ ДЛЯ НАСТРОЕНИЯ · НЕ ДОКУМЕНТАЛЬНОЕ ФОТО</p>}
    <div class="hero-scroll-cue" aria-hidden="true">
      <span>ИССЛЕДОВАТЬ</span>
      <span class="hero-scroll-line"></span>
    </div>
  </div>
</section>
