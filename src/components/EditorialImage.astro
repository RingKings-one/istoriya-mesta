---
import manifest from '../generated/image-manifest.json';
import { ruzaMedia, type PlacePhoto } from '../content/ruza-media';
import { imageAssets, imageSrcSet } from '../data';

const {
  src,
  alt = '',
  sizes = '100vw',
  loading = 'lazy',
  fetchpriority,
  width,
  height,
  position,
  className,
  pictureClass,
} = Astro.props;

const asset = Object.values(imageAssets).find((candidate) => candidate.src === src);
const local = asset ? manifest.assets[asset.localKey] : undefined;
const documentary: PlacePhoto | undefined = Object.values(ruzaMedia).find((photo) => photo.src === src);
const documentarySrcSet = documentary?.compact
  ? `${documentary.compact.src} ${documentary.compact.width}w, ${src} ${documentary.width}w`
  : undefined;
const fallbackSrcSet = asset && !local ? imageSrcSet(src) : documentarySrcSet;
const archiveImages = new Set([
  '/images/ruza/archive-ruza-plan-1784.webp',
  '/images/ruza-museum-postcard.webp',
  '/images/ruza/archive-postcard-back.webp',
  '/images/ruza/archive-winter-cathedral.webp',
  '/images/ruza/archive-ruza-town-view.webp',
  '/images/ruza/petrishchevo-memorial-1950s.webp',
]);
const grade = archiveImages.has(src) ? 'grade-archive' : documentary ? 'grade-now' : undefined;
const focalPoint = position ?? asset?.focalPoint ?? 'center';
const avifSrcSet = local?.variants.avif.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
const webpSrcSet = local?.variants.webp.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
---
<picture class:list={['editorial-picture', pictureClass]}>
  {local && <source type="image/avif" srcset={avifSrcSet} sizes={sizes} />}
  {local && <source type="image/webp" srcset={webpSrcSet} sizes={sizes} />}
  <img
    class:list={[className, grade]}
    src={src}
    srcset={fallbackSrcSet}
    sizes={fallbackSrcSet ? sizes : undefined}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    width={local?.width ?? width ?? documentary?.width}
    height={local?.height ?? height ?? documentary?.height}
    style={focalPoint ? `object-position: ${focalPoint};` : undefined}
  />
</picture>
