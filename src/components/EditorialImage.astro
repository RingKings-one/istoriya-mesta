---
import manifest from '../generated/image-manifest.json';
import { imageAssets, imageSrcSet } from '../data';

const {
  src,
  alt = '',
  sizes = '100vw',
  loading = 'lazy',
  fetchpriority,
  width,
  height,
  position,
  className,
  pictureClass,
} = Astro.props;

const asset = Object.values(imageAssets).find((candidate) => candidate.src === src);
const local = asset ? manifest.assets[asset.localKey] : undefined;
const focalPoint = position ?? asset?.focalPoint ?? 'center';
const avifSrcSet = local?.variants.avif.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
const webpSrcSet = local?.variants.webp.map((variant) => `${variant.src} ${variant.width}w`).join(', ');
---
<picture class:list={['editorial-picture', pictureClass]}>
  {local && <source type="image/avif" srcset={avifSrcSet} sizes={sizes} />}
  {local && <source type="image/webp" srcset={webpSrcSet} sizes={sizes} />}
  <img
    class={className}
    src={src}
    srcset={asset && !local ? imageSrcSet(src) : undefined}
    sizes={asset && !local ? sizes : undefined}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    width={local?.width ?? width}
    height={local?.height ?? height}
    style={focalPoint ? `object-position: ${focalPoint};` : undefined}
  />
</picture>
