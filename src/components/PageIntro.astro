---
import { imageSrcSet } from '../data';
const { eyebrow, title, description, image } = Astro.props;
---
<section class="page-intro" aria-labelledby="page-title">
  {image && <img src={image} srcset={imageSrcSet(image)} sizes="100vw" alt="" fetchpriority="high" decoding="async" />}
  <div class="page-intro-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title">{title}</h1>
    <p class="lead">{description}</p>
  </div>
</section>
