---
import EditorialImage from './EditorialImage.astro';
import { ruzaMedia } from '../content/ruza-media';

const epochs = [
  { date: '1328', title: 'Город на высоком берегу', text: 'Рузу упоминает грамота Ивана Калиты. За точку отсчёта здесь принимают 1328 год. Земляные валы Городка помогают увидеть, почему укрепление появилось над речной долиной.', href: '/stories/gorod-kotoryy-pomnit/' },
  { date: 'XVII век', title: 'След крепости в музейном зале', text: 'В Рузском музее хранится пушечный ствол XVII века. Сегодня историю укрепления можно читать по музейному предмету, макету и сохранившимся валам.', href: '/archive/#old-fortress' },
  { date: '1782', title: 'Руза становится уездным городом', text: 'Руза получила статус уездного города Московской губернии. Через два года для её центра утвердили регулярный план.', href: '/stories/gorod-po-ulitsam/' },
  { date: '1784', title: 'Улицы по линейке', text: 'На регулярном плане появились прямые улицы и кварталы. Их рисунок до сих пор читается от бывшей Торговой площади.', href: '/archive/#plan-1784' },
  { date: '1812', title: 'Война приходит в уезд', text: 'Во время Отечественной войны через Рузский уезд прошли французские войска. Жители участвовали в ополчении. Военные события того года стали частью истории города и окрестностей.' },
  { date: '1906', title: 'Музей у реки', text: 'При библиотеке-читальне открылся музей местного края. Его первое здание можно увидеть на дореволюционной открытке.', href: '/archive/#postcard' },
  { date: '1908', title: 'Дом, приехавший из Выборга', text: 'Деревянный особняк Леонтьева перевезли в Рузу из Выборга. Его история добавляет к городским храмам и торговым фасадам ещё один слой — деревянный модерн.', href: '/stories/gorod-po-ulitsam/' },
  { date: '1942', title: 'Город после оккупации', text: 'Рузу освободили 17 января. Военные фотографии хранятся в краеведческом музее, а мемориал на площади Партизан сохраняет имена погибших ружан.', href: '/archive/#war-memory' },
  { date: '1966', title: 'В округе появляется большая вода', text: 'Рузское водохранилище вошло в систему, которая регулирует сток и помогает снабжать столичный регион водой. За пределами города у реки появился совсем другой масштаб.', href: '/stories/mezhdu-vodoy-i-lesom/' },
  { date: '2009', title: 'Вода становится спортивной', text: 'Открылся Дворец водных видов спорта. Маленький город получил площадку для тренировок и соревнований по водным дисциплинам.', href: '/stories/ruza-segodnya/' },
  { date: 'Сегодня', title: 'Город продолжается за пределами площади', text: 'Начните с кофе на Федеративной, потом выберите свой путь: по старым улицам, к Городку или по окрестностям.', href: '/routes/' },
];
const trail = 'M 42 206 C 61 232, 61 139, 80 165 C 101 145, 101 204, 122 184 C 136 210, 136 107, 150 133 C 171 113, 171 132, 192 112 C 210 138, 210 115, 228 141 C 247 121, 247 136, 266 116 C 269.5 142, 269.5 52, 273 78 C 297 58, 297 77, 321 57 C 338 83, 338 55, 355 81 C 373 61, 373 60, 391 40';
const points = [
  [42, 206], [80, 165], [122, 184], [150, 133], [192, 112], [228, 141],
  [266, 116], [273, 78], [321, 57], [355, 81], [391, 40],
];
---
<section class="section city-epochs" id="city-epochs" aria-labelledby="epochs-title" data-epochs>
  <header class="epochs-heading">
    <p class="eyebrow">ГОРОД В РАЗНЫЕ ВЕКА</p>
    <h2 id="epochs-title">От крепости до города спорта</h2>
  </header>
  <div class="epochs-layout">
    <figure class="epoch-map">
      <div class="map-window" data-map-window>
        <div class="map-sheet" data-map-sheet>
          <EditorialImage src={ruzaMedia.archiveMap.src} alt="" />
          <svg viewBox="0 0 430 245" aria-hidden="true" focusable="false">
            <path class="map-trace" d={trail} />
            <path class="map-ink" data-epoch-ink d={trail} pathLength="1" />
            {points.map(([x, y]) => <circle class="map-point" data-epoch-point cx={x} cy={y} r="3.4" />)}
            <circle class="map-traveler" data-epoch-traveler cx="42" cy="206" r="5.2" />
          </svg>
        </div>
      </div>
      <div class="map-imprint" aria-hidden="true">
        <span class="map-year" data-epoch-year>{epochs[0].date}</span>
        <span class="map-entry" data-epoch-name>{epochs[0].title}</span>
      </div>
      <figcaption>Путь по эпохам поверх плана Рузы 1784 года</figcaption>
    </figure>
    <ol class="epoch-list">
      {epochs.map(({ date, title, text, href }) => (
        <li class="epoch" data-epoch data-date={date} data-title={title}>
          <p class="epoch-date">{date}</p>
          <h3>{title}</h3>
          <p>{text}</p>
          {href && <a class="text-link" href={href} aria-label={`Читать дальше: ${title}`}>Читать дальше</a>}
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const timeline = document.querySelector<HTMLElement>('[data-epochs]');
  const entries = Array.from(timeline?.querySelectorAll<HTMLElement>('[data-epoch]') ?? []);
  const points = timeline?.querySelectorAll('[data-epoch-point]');
  const ink = timeline?.querySelector<SVGPathElement>('[data-epoch-ink]');
  const traveler = timeline?.querySelector('[data-epoch-traveler]');
  const sheet = timeline?.querySelector<HTMLElement>('[data-map-sheet]');
  const viewport = timeline?.querySelector<HTMLElement>('[data-map-window]');
  const year = timeline?.querySelector('[data-epoch-year]');
  const name = timeline?.querySelector('[data-epoch-name]');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  let active = -1;
  let frame = 0;

  function drawMap(progress: number) {
    if (!ink || !sheet || !viewport) return;
    ink.style.strokeDashoffset = String(1 - progress);
    const point = ink.getPointAtLength(progress * ink.getTotalLength());
    traveler?.setAttribute('cx', point.x.toFixed(2));
    traveler?.setAttribute('cy', point.y.toFixed(2));

    const minX = Math.min(0, viewport.clientWidth - sheet.offsetWidth);
    const minY = Math.min(0, viewport.clientHeight - sheet.offsetHeight);
    const x = Math.min(0, Math.max(minX, viewport.clientWidth * .42 - point.x * sheet.offsetWidth / 430));
    const y = Math.min(0, Math.max(minY, viewport.clientHeight * .52 - point.y * sheet.offsetHeight / 245));
    sheet.style.transform = `translate3d(${x}px, ${y}px, 0)`;
  }

  function updateEpoch() {
    frame = 0;
    if (!entries.length || motion.matches) return;
    const first = entries[0].getBoundingClientRect().top;
    const last = entries[entries.length - 1].getBoundingClientRect().top;
    const progress = Math.max(0, Math.min(1, (window.innerHeight * .46 - first) / Math.max(1, last - first)));
    drawMap(progress);
    const index = Math.round(progress * (entries.length - 1));
    points?.forEach((point, i) => {
      point.toggleAttribute('data-reached', i <= index);
      point.toggleAttribute('data-current', i === index);
    });
    if (index === active) return;

    const firstUpdate = active === -1;
    active = index;
    entries.forEach((entry, i) => entry.toggleAttribute('data-current', i === index));
    if (year) {
      year.textContent = entries[index].dataset.date ?? '';
      if (!firstUpdate) {
        year.getAnimations().forEach((animation) => animation.cancel());
        year.animate(
          [{ opacity: .45, transform: 'translateY(5px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 280, easing: 'ease-out' },
        );
      }
    }
    if (name) name.textContent = entries[index].dataset.title ?? '';
  }

  function scheduleEpoch() {
    if (!frame && !motion.matches) frame = requestAnimationFrame(updateEpoch);
  }

  function syncMotion() {
    timeline?.toggleAttribute('data-tracking', !motion.matches);
    if (motion.matches) {
      if (ink) ink.style.strokeDashoffset = '0';
      if (sheet) sheet.style.transform = '';
    }
    scheduleEpoch();
  }

  if (timeline && entries.length) {
    window.addEventListener('scroll', scheduleEpoch, { passive: true });
    window.addEventListener('resize', scheduleEpoch);
    motion.addEventListener('change', syncMotion);
    syncMotion();
  }
</script>

<style>
.city-epochs {
  background:#202720;
  border-block:1px solid #d7c7b224;
  scroll-margin-top:78px;
}
.epochs-heading {
  max-width:750px;
  margin-bottom:clamp(30px,6vw,80px);
}
.epochs-heading h2 {
  font:400 clamp(39px, 6.4vw, 88px)/.98 var(--serif);
  letter-spacing:-.045em;
  margin:12px 0 0;
}
.epochs-layout {
  grid-template-columns:minmax(0,1.04fr) minmax(0,.88fr);
  align-items:start;
  gap:clamp(30px,6vw,90px);
  display:grid;
}
.epoch-map {
  background:#2e3328;
  border:1px solid #d7c7b23d;
  min-width:0;
  margin:0;
  padding:clamp(11px,2.2vw,28px);
  position:static;
  top:clamp(90px,15vh,145px);
}
[data-tracking] .epoch-map {
  position:sticky;
}
.city-epochs:not([data-tracking]) .map-imprint {
  display:none;
}
.map-window {
  isolation:isolate;
  aspect-ratio:430/245;
  background:#b9a27c;
  position:relative;
  overflow:hidden;
}
.map-sheet {
  width:100%;
  height:100%;
  position:absolute;
  inset:0;
}
[data-tracking] .map-sheet {
  width:188%;
  height:188%;
}
.map-window :global(picture),.map-window svg {
  width:100%;
  height:100%;
  position:absolute;
  inset:0;
}
.map-window :global(img) {
  object-fit:cover;
  opacity:.78;
  filter:saturate(.55)contrast(1.06)brightness(1.04)hue-rotate(16deg);
  width:100%;
  height:100%;
  display:block;
}
.map-window svg {
  overflow:visible;
}
.map-trace,.map-ink {
  fill:none;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.map-trace {
  stroke:#583c26;
  stroke-width:1.15px;
  stroke-dasharray:2 6;
  opacity:.55;
}
.map-ink {
  stroke:#73381f;
  stroke-width:2.15px;
}
[data-tracking] .map-ink {
  stroke-dashoffset:1px;
}
.map-point {
  fill:#efe4d2;
  stroke:#73381f;
  stroke-width:1px;
  opacity:.45;
}
[data-tracking] .map-point[data-reached] {
  opacity:1;
}
.map-traveler {
  fill:#f4d7a6;
  stroke:#3c2418;
  stroke-width:1.35px;
}
.map-imprint {
  justify-content:space-between;
  align-items:baseline;
  gap:12px;
  min-height:3.15rem;
  margin-top:13px;
  display:flex;
}
.map-year {
  color:#eccea9;
  font:italic 400 clamp(29px, 5.6vw, 74px)/.96 var(--editorial-serif);
  flex:none;
}
.map-entry {
  color:var(--light);
  text-align:end;
  font-size:.94rem;
  line-height:1.2;
}
figcaption {
  color:var(--muted);
  margin-top:8px;
  font-size:.75rem;
}
.epoch-list {
  margin:0;
  padding:0;
  list-style:none;
}
.epoch {
  border-top:1px solid #d7c7b240;
  min-height:210px;
  padding:23px 0 clamp(28px,5vw,68px);
}
.epoch .epoch-date {
  color:#e2bd9b;
  font:italic 400 clamp(31px, 3.5vw, 49px)/1 var(--editorial-serif);
  margin:0 0 12px;
}
.epoch h3 {
  font:400 clamp(26px, 3.25vw, 47px)/1.04 var(--serif);
  margin:0 0 10px;
}
.epoch p:not(.epoch-date) {
  max-width:54ch;
  color:var(--muted);
}
@media (prefers-reduced-motion:no-preference) {
  [data-tracking] .map-point {
    transition:opacity .35s;
  }
  [data-tracking] .map-point[data-current] {
    fill:#f7d49a;
  }
  [data-tracking] .epoch {
    transition:border-color .35s;
  }
  [data-tracking] .epoch[data-current] {
    border-color:#b98058;
  }
}
@media (width<=760px) {
  .epochs-layout {
    grid-template-columns:minmax(0,1fr);
    gap:26px;
  }
  .epoch-map {
    z-index:3;
    padding:10px 12px;
    top:12px;
  }
  .map-window {
    aspect-ratio:2.28;
    max-height:24svh;
  }
  .map-imprint {
    min-height:2.1rem;
    margin-top:8px;
  }
  .map-entry {
    font-size:.78rem;
  }
  .epoch {
    min-height:0;
    padding-bottom:34px;
  }
}
@media (prefers-reduced-motion:reduce) {
  .epoch-map {
    position:static;
  }
  .map-imprint {
    display:none;
  }
}
</style>
