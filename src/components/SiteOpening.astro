<div class="site-opening" id="site-opening" aria-hidden="true">
  <div class="opening-stamp">
    <div class="opening-ring"></div>
    <div class="opening-mark">
      <span class="opening-steam"></span>
      <span class="opening-cup"></span>
      <span class="opening-title">История места</span>
    </div>
  </div>
</div>
<script is:inline>
  (() => {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    if (motion.matches) return;
    try {
      if (sessionStorage.getItem('istoriya-opening-stamp')) return;
      sessionStorage.setItem('istoriya-opening-stamp', 'yes');
    } catch {
      return;
    }
    const stamp = document.getElementById('site-opening');
    if (!stamp) return;

    const listeners = new AbortController();
    const closeOpening = () => {
      stamp.classList.remove('is-playing');
      document.documentElement.classList.remove('await-opening');
      listeners.abort();
      clearTimeout(fallback);
    };
    const fallback = window.setTimeout(closeOpening, 2650);
    stamp.addEventListener('animationend', (event) => {
      if (event.target === stamp) closeOpening();
    }, { signal: listeners.signal });
    window.addEventListener('keydown', closeOpening, { signal: listeners.signal });
    window.addEventListener('pointerdown', closeOpening, { signal: listeners.signal });
    window.addEventListener('scroll', closeOpening, { passive: true, signal: listeners.signal });
    motion.addEventListener('change', closeOpening, { signal: listeners.signal });
    document.documentElement.classList.add('await-opening');
    stamp.classList.add('is-playing');
  })();
</script>
<style>
  .site-opening { display: none; }
  @media(prefers-reduced-motion: no-preference) {
    .site-opening.is-playing {
      display: grid;
      position: fixed;
      inset: 0;
      z-index: 100;
      place-items: center;
      background: radial-gradient(ellipse at center,#302a20,#171c18 67%);
      pointer-events: none;
      animation: opening-paper 2450ms both;
    }
    .opening-stamp {
      position: relative;
      display: grid;
      place-items: center;
      width: clamp(172px, 34vw, 246px);
      aspect-ratio: 1;
      color: #e4c5a5;
      transform: rotate(-5deg);
    }
    .opening-ring {
      position: absolute;
      inset: 0;
      border: 2px solid #b27854;
      border-radius: 47% 54% 49% 52%;
      box-shadow: 0 0 0 2px #8f533834, inset 0 0 0 7px #8f533821;
      mask-image: conic-gradient(#000 8deg,#0008 70deg,#000 149deg,#000b 260deg,#000 360deg);
      animation: opening-trace 1.36s .36s both;
    }
    .opening-mark { position: relative; display: grid; gap: 24px; justify-items: center; font: italic 400 clamp(20px,4vw,30px)/1 var(--editorial-serif); }
    .opening-cup { position: relative; display: block; width: 33px; height: 22px; border: 1px solid; border-radius: 0 0 40% 40%; animation: opening-ink .55s both; }
    .opening-cup::after { position: absolute; top: 3px; left: 100%; width: 9px; height: 10px; border: 1px solid; border-inline-start: 0; border-radius: 0 65% 65% 0; content: ''; }
    .opening-cup::before { position: absolute; top: 27px; left: -5px; width: 43px; border-top: 1px solid; content: ''; }
    .opening-steam { position: absolute; top: -26px; left: calc(50% - 5px); width: 10px; height: 16px; border: solid #d2ac7e; border-width: 0 1px 0 0; border-radius: 40%; transform: rotate(14deg); animation: opening-steam 1.4s .18s both; }
    .opening-title { animation: opening-ink .58s .83s both; }
  }
  @keyframes opening-paper { 0%, 76% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes opening-ink { from { opacity: 0; translate: 0 5px; } to { opacity: 1; translate: 0 0; } }
  @keyframes opening-trace {
    from { clip-path: inset(100% -5% -5% -5%); transform: rotate(-12deg) scale(1.06); }
    to { clip-path: inset(-5%); transform: rotate(0) scale(1); }
  }
  @keyframes opening-steam {
    0% { opacity: 0; translate: 0 8px; }
    35%, 65% { opacity: .85; }
    100% { opacity: .42; translate: 0 -4px; }
  }
</style>
