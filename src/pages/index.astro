---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { images } from '../data';
---
<BaseLayout
  title="История места — Атлас живых историй"
  description="Открываем характер городов через места, людей, детали и маршруты. Первая глава — Руза."
>
  <section class="hero">
    <img src={images.hero} alt="" fetchpriority="high" />
    <div class="hero-content">
      <p class="eyebrow">АТЛАС ЖИВЫХ ИСТОРИЙ</p>
      <h1>У каждого<br />места есть<br /><em>история.</em></h1>
      <p class="lead">Мы помогаем её почувствовать.</p>
      <a class="button button-filled" href="/cities/">Открыть атлас ↗</a>
    </div>
    <span class="hero-index" aria-hidden="true">01 — 06</span>
  </section>

  <section class="section intro-grid">
    <div>
      <p class="eyebrow">ЗАМЕТИТЬ БОЛЬШЕ</p>
      <h2>Путешествие начинается не с расстояния, а с внимания.</h2>
      <p>
        У каждого города есть свой ритм. Он звучит в знакомых улицах, старых фасадах,
        разговорах за чашкой кофе и деталях, мимо которых легко пройти.
      </p>
      <a class="text-link" href="/stories/">Почувствовать атмосферу ↗</a>
    </div>
    <img src={images.street} alt="" loading="lazy" />
  </section>

  <section class="city-feature">
    <img src={images.river} alt="" loading="lazy" />
    <div class="feature-copy">
      <p class="eyebrow">ПЕРВАЯ ГЛАВА · 01</p>
      <h2>Руза</h2>
      <p>
        Небольшой город с большой историей. Начинаем собирать его живой портрет —
        через места, людей, память и маршруты.
      </p>
      <a class="text-link" href="/cities/ruza/">Исследовать город ↗</a>
    </div>
  </section>

  <section class="section route-feature">
    <div class="route-feature-copy">
      <p class="eyebrow">МЕДЛЕННОЕ ПУТЕШЕСТВИЕ</p>
      <h2>Иногда главное — свернуть с привычного пути.</h2>
      <p>
        Выбирайте маршрут, задерживайтесь у деталей и открывайте город в собственном
        темпе. Не список достопримечательностей, а прогулка с ощущением места.
      </p>
      <a class="text-link" href="/routes/">Найти свой маршрут ↗</a>
    </div>
    <img src={images.forest} alt="" loading="lazy" />
  </section>

  <section class="section discovery-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">ОТКРЫВАЙТЕ СВОЁ</p>
        <h2>У каждого пути — своя история.</h2>
      </div>
      <p>Выберите, с чего начнётся ваше знакомство.</p>
    </div>
    <div class="card-grid">
      <FeatureCard
        image={images.church}
        eyebrow="АТЛАС"
        title="Города"
        text="Открывайте места и их характер."
        href="/cities/"
        number="01"
      />
      <FeatureCard
        image={images.coffee}
        eyebrow="АТМОСФЕРА"
        title="Кофейня"
        text="Пространство встреч, вкуса и впечатлений."
        href="/cafe/"
        number="02"
      />
      <FeatureCard
        image={images.camera}
        eyebrow="ПАМЯТЬ"
        title="Архив"
        text="Фотографии и визуальные следы времени."
        href="/archive/"
        number="03"
      />
    </div>
  </section>
</BaseLayout>
