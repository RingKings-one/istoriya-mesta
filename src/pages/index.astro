---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import HeroSection from '../components/HeroSection.astro';
import ArrowMark from '../components/ArrowMark.astro';
import { images, isPlaceholderImage } from '../data';
import EditorialImage from '../components/EditorialImage.astro';
---
<BaseLayout
  title="История места — Атлас живых историй"
  description="Открываем характер городов через места, людей, детали и маршруты. Первая глава — Руза."
>
  <HeroSection />

  <section class="section home-intro" id="atlas-opening" tabindex="-1">
    <div class="home-intro-meta">
      <p class="eyebrow">ЗАМЕТИТЬ БОЛЬШЕ</p>
      <span class="home-folio">01 <i>—</i> ВНИМАНИЕ К МЕСТУ</span>
    </div>
    <div class="home-intro-copy" data-reveal>
      <h2>Путешествие начинается не с расстояния, а с <em>внимания.</em></h2>
      <p>
        У каждого города есть свой ритм. Он звучит в знакомых улицах, старых фасадах,
        разговорах за чашкой кофе и деталях, мимо которых легко пройти.
      </p>
      <a class="text-link" href="/stories/">Почувствовать атмосферу <ArrowMark direction="forward" /></a>
    </div>
    <figure class="home-intro-image" data-reveal>
      <EditorialImage src={images.street} sizes="(max-width: 680px) 100vw, 54vw" alt="" />
      <figcaption><span>НАСТРОЕНИЕ ГОРОДСКОЙ СРЕДЫ</span>{isPlaceholderImage(images.street) && <span>ВРЕМЕННЫЙ ВИЗУАЛ</span>}</figcaption>
    </figure>
  </section>

  <section class="home-principle" data-reveal aria-label="Принцип проекта">
    <span class="home-principle-index">ПРИНЦИП / 01</span>
    <p>Не просто показать место.<br /><em>Помочь почувствовать его.</em></p>
  </section>

  <section class="city-feature home-city-feature">
    <div class="home-city-image">
      <EditorialImage src={images.river} sizes="(max-width: 680px) 100vw, 52vw" alt="" />
      <span class="home-image-index">ГЛАВА 01 <i>·</i> РУЗА</span>
      {isPlaceholderImage(images.river) && <span class="home-image-disclosure">ВРЕМЕННЫЙ ВИЗУАЛ ДЛЯ НАСТРОЕНИЯ</span>}
    </div>
    <div class="feature-copy home-city-copy">
      <p class="eyebrow">ПЕРВАЯ ГЛАВА · 01</p>
      <span class="home-chapter-label">МОСКОВСКАЯ ОБЛАСТЬ</span>
      <h2>Руза</h2>
      <p>
        Небольшой город с большой историей. Начинаем собирать его живой портрет —
        через места, людей, память и маршруты.
      </p>
      <a class="text-link" href="/cities/ruza/">Исследовать город <ArrowMark direction="forward" /></a>
      <span class="home-city-edition">АТЛАС ЖИВЫХ ИСТОРИЙ <i>—</i> ПЕРВАЯ ГЛАВА</span>
    </div>
  </section>

  <section class="section route-feature home-route-feature">
    <div class="route-feature-copy" data-reveal>
      <p class="eyebrow">МЕДЛЕННОЕ ПУТЕШЕСТВИЕ</p>
      <span class="home-folio">02 <i>—</i> ДВИЖЕНИЕ И НАБЛЮДЕНИЕ</span>
      <h2>Иногда главное — свернуть с привычного пути.</h2>
      <p>
        Выбирайте маршрут, задерживайтесь у деталей и открывайте город в собственном
        темпе. Не список достопримечательностей, а прогулка с ощущением места.
      </p>
      <a class="text-link" href="/routes/">Найти свой маршрут <ArrowMark direction="forward" /></a>
    </div>
    <figure class="home-route-image" data-reveal>
      <EditorialImage src={images.forest} sizes="(max-width: 680px) 100vw, 50vw" alt="" />
      <figcaption><span>ПУТЬ КАК СПОСОБ УВИДЕТЬ БОЛЬШЕ</span>{isPlaceholderImage(images.forest) && <span>ВРЕМЕННЫЙ ВИЗУАЛ</span>}</figcaption>
    </figure>
  </section>

  <section class="section discovery-section">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">ОТКРЫВАЙТЕ СВОЁ</p>
        <span class="home-folio">03 <i>—</i> НАПРАВЛЕНИЯ ИССЛЕДОВАНИЯ</span>
        <h2>У каждого пути — своя история.</h2>
      </div>
      <p>Выберите, с чего начнётся ваше знакомство.</p>
    </div>
    <div class="card-grid">
      <FeatureCard
        image={images.church}
        eyebrow="АТЛАС"
        title="Города"
        text="Открывайте места и их характер."
        href="/cities/"
        number="01"
      />
      <FeatureCard
        image={images.coffee}
        eyebrow="АТМОСФЕРА"
        title="Кофейня"
        text="Пространство встреч, вкуса и впечатлений."
        href="/cafe/"
        number="02"
      />
      <FeatureCard
        image={images.camera}
        eyebrow="ПАМЯТЬ"
        title="Архив"
        text="Фотографии и визуальные следы времени."
        href="/archive/"
        number="03"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: .58fr 1fr 1.12fr;
    gap: clamp(24px, 4vw, 62px);
    align-items: start;
  }
  .home-intro-meta { display: grid; gap: 22px; }
  .home-folio {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--stone);
    font-size: 9px;
    letter-spacing: .14em;
  }
  .home-folio i { color: var(--rust); font-style: normal; }
  .home-intro-copy h2 {
    margin: 0 0 20px;
    font: 400 clamp(34px, 4.1vw, 58px)/1.03 var(--serif);
    letter-spacing: -.025em;
  }
  .home-intro-copy h2 em { color: var(--stone); font-weight: 400; }
  .home-intro-copy > p { max-width: 420px; margin: 0 0 22px; color: var(--muted); }
  .home-intro-image,.home-route-image { min-width: 0; margin: 0; }
  .home-intro-image { padding-top: 38px; }
  .home-intro-image img { width: 100%; aspect-ratio: 1.18; }
  .home-intro-image figcaption,.home-route-image figcaption {
    display: flex; justify-content: space-between; gap: 12px;
    padding-top: 11px; color: var(--muted); font-size: 8px; letter-spacing: .12em;
  }
  .home-principle {
    position: relative; display: grid; grid-template-columns: .58fr 2.12fr;
    align-items: center; gap: 24px; padding: 34px 7vw;
    border-top: 1px solid #d7c7b233; border-bottom: 1px solid #d7c7b233;
    background: #202720;
  }
  .home-principle-index { color: var(--rust); font-size: 9px; letter-spacing: .16em; }
  .home-principle > p {
    margin: 0; color: var(--light); font: clamp(23px, 3vw, 38px)/1.15 var(--serif);
  }
  .home-principle > p em { color: var(--stone); font-weight: 400; }
  .home-city-feature { grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); }
  .home-city-image { position: relative; min-width: 0; min-height: 540px; overflow: hidden; }
  .home-city-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .home-image-index,.home-image-disclosure {
    position: absolute; z-index: 1; left: 24px; color: #f1e9dd;
    font-size: 8px; letter-spacing: .15em; text-shadow: 0 1px 12px #0009;
  }
  .home-image-index { top: 24px; }
  .home-image-index i,.home-city-edition i { color: var(--rust); font-style: normal; }
  .home-image-disclosure { bottom: 22px; opacity: .78; font-size: 7px; }
  .home-city-copy { position: relative; align-self: center; padding: clamp(36px, 6vw, 88px); }
  .home-chapter-label { display: block; margin: 30px 0 8px; color: var(--muted); font-size: 8px; letter-spacing: .17em; }
  .home-city-copy h2 { margin-bottom: 16px; font-size: clamp(64px, 8vw, 108px); line-height: .9; }
  .home-city-copy > p:not(.eyebrow) { max-width: 390px; }
  .home-city-edition { display: block; margin-top: 42px; color: var(--stone); font-size: 8px; letter-spacing: .14em; }
  .home-route-feature { grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); }
  .home-route-feature .home-folio { margin-bottom: 24px; }
  .home-route-feature h2 { max-width: 620px; }
  .home-route-image img { width: 100%; aspect-ratio: 1.34; }
  .discovery-section .home-folio { margin-bottom: 18px; }
  .discovery-section .section-heading h2 { margin-top: 12px; }
  @media(max-width: 900px) {
    .home-intro { grid-template-columns: .45fr 1fr; }
    .home-intro-image { grid-column: 2; padding-top: 0; }
    .home-city-image { min-height: 460px; }
    .home-city-copy { padding: 36px; }
  }
  @media(max-width: 680px) {
    .home-intro { grid-template-columns: 1fr; gap: 18px; }
    .home-intro-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }
    .home-intro-image { grid-column: auto; }
    .home-intro-image img { aspect-ratio: 1.25; }
    .home-intro-image figcaption,.home-route-image figcaption { font-size: 7px; }
    .home-principle { grid-template-columns: 1fr; gap: 10px; padding: 26px 22px; }
    .home-principle-index { grid-column: 1 / -1; }
    .home-principle > p { font-size: clamp(23px, 6vw, 31px); }
    .home-city-feature { grid-template-columns: 1fr; gap: 0; }
    .home-city-image { min-height: 390px; }
    .home-city-copy { padding: 34px 22px 54px; }
    .home-chapter-label { margin-top: 22px; }
    .home-city-edition { margin-top: 28px; }
    .home-route-feature { grid-template-columns: 1fr; gap: 24px; }
    .home-route-feature .home-folio { margin-bottom: 18px; }
    .discovery-section .home-folio { margin-bottom: 14px; }
  }
  @media(max-width: 360px) {
    .home-image-index,.home-image-disclosure { left: 16px; }
    .home-city-image { min-height: 330px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .home-intro-image img,.home-route-image img { transition: none; }
  }
</style>
