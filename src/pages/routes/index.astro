---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import { ruzaSources, ruzaWalks } from '../../content/ruza';
---
<BaseLayout title="Пешие маршруты по Рузе — История места" description="Две прогулки от кофейни на Федеративной через площадь Партизан, собор и краеведческий музей.">
  <PageIntro eyebrow="ПЕШИЕ МАРШРУТЫ · РУЗА" title="Руза пешком" description="Начните с кофе на Федеративной. Дальше можно задержаться в центре или продолжить прогулку до Городка." />
  <div class="section walks">
    <nav class="walk-index" aria-label="Выбрать прогулку">
      {ruzaWalks.map(({ id, title }) => <a class="text-link" href={`#${id}`}>{title}</a>)}
    </nav>
    {ruzaWalks.map((walk) => (
      <section class="walk" id={walk.id} aria-labelledby={`${walk.id}-title`}>
        <header>
          <h2 id={`${walk.id}-title`}>{walk.title}</h2>
          <p>{walk.dek}</p>
        </header>
        {walk.id === 'ruza-za-den' && (
          <p class="route-note">Перед выходом проверьте <a href={ruzaSources.park.url}>режим работы Городка</a>. Если парк закрыт, выберите <a href="#staraya-ruza">прогулку по центру</a>.</p>
        )}
        <ol class="walk-stops">
          {walk.stops.map((stop) => (
            <li>
              <h3>{stop.title}</h3>
              <p>{stop.note}</p>
              <div class="stop-links">
                <a href={stop.map}>Яндекс Карты</a>
                {stop.story && <a href={stop.story}>Подробнее об остановке</a>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <EditorialPath current="routes" />
</BaseLayout>

<style>
  .walks { padding-top: 0; }
  .walk-index { display: flex; flex-wrap: wrap; gap: 16px 28px; margin-bottom: clamp(32px, 5vw, 68px); }
  .walk { scroll-margin-top: 100px; padding-block: 28px 42px; border-top: 1px solid #d7c7b244; }
  .walk h2 { margin: 0 0 10px; font: 400 clamp(32px, 5vw, 56px)/1.04 var(--serif); }
  .walk p { max-width: 55ch; color: var(--muted); }
  .route-note { padding-inline-start: 16px; border-inline-start: 2px solid var(--rust); }
  .stop-links { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  .stop-links a, .route-note a { color: var(--stone); text-decoration: underline; text-underline-offset: .22em; }
  .walk-stops { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 195px), 1fr)); gap: 28px; margin: 30px 0 0; padding: 0; list-style-position: inside; }
  .walk-stops li { padding-top: 18px; border-top: 1px solid #a8664b88; }
  .walk-stops li::marker { color: var(--stone); }
  .walk-stops h3 { margin: 10px 0; font: 400 25px/1.08 var(--serif); }
</style>
