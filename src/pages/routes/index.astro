---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import ArrowMark from '../../components/ArrowMark.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import { ruzaMedia } from '../../content/ruza-media';
import { ruzaWalks } from '../../content/ruza-walks';
---
<BaseLayout title="Руза пешком — История места" description="Две прогулки по Рузе от кофейни на Федеративной через площадь Партизан, собор и музей.">
  <PageIntro variant="route" eyebrow="АТЛАС · ПЕШИЕ МАРШРУТЫ" edition="МОСКОВСКАЯ ОБЛАСТЬ" title="Руза пешком" description="От кофе на Федеративной до старых фасадов и высокого берега реки." image={ruzaMedia.park.src} />
  <section class="section walks" aria-label="Выбрать прогулку">
    {ruzaWalks.map((walk) => (
      <article class="walk" id={walk.id}>
        <PhotoFrame photo={walk.cover} caption={false} />
        <div class="walk-copy" data-reveal>
          <p class="eyebrow">{walk.includesPark ? 'ЦЕНТР И ГОРОДОК · 5 ОСТАНОВОК' : 'ИСТОРИЧЕСКИЙ ЦЕНТР · 4 ОСТАНОВКИ'}</p>
          <h2>{walk.title}</h2>
          <p>{walk.lead}</p>
          <a class="text-link" href={`/routes/${walk.id}/`}>Открыть маршрут <ArrowMark direction="forward" /></a>
        </div>
      </article>
    ))}
  </section>
  <EditorialPath current="routes" />
</BaseLayout>

<style>
  .walks { display: grid; gap: clamp(36px, 7vw, 108px); }
  .walk { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(24px, 6vw, 96px); align-items: center; scroll-margin-top: 90px; }
  .walk:nth-child(even) { grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr); }
  .walk:nth-child(even) :global(figure) { grid-column: 2; grid-row: 1; }
  .walk :global(figure) { --photo-ratio: 1.45; }
  .walk h2 { margin: 10px 0 16px; font: 400 clamp(34px, 5.3vw, 76px)/.98 var(--serif); letter-spacing: -.035em; }
  .walk-copy > p:not(.eyebrow) { max-width: 38ch; color: var(--muted); }
  @media (max-width: 760px) {
    .walk, .walk:nth-child(even) { grid-template-columns: minmax(0, 1fr); }
    .walk:nth-child(even) :global(figure) { grid-column: auto; grid-row: auto; }
  }
</style>
