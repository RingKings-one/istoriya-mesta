---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import ArrowMark from '../../components/ArrowMark.astro';
import { ruzaMedia as photo } from '../../content/ruza-media';
import { ruzaSources } from '../../content/ruza';

const cafeHero = photo.cafeInterior;
const reviews = [
  { text: 'Стильный интерьер с картой города.', author: 'Elizaveta Mer' },
  { text: 'Нравится, что редко бывают толпы людей и можно посидеть почитать', author: 'Дарья Карамнова' },
];
---
<BaseLayout sharePhoto={cafeHero} title="Кофейня «История места» в Рузе" description="Кофейня на Федеративной, 7. Столик у окна, кофе, витрина выпечки и прогулки по Рузе.">
  <header class="cafe-opening" data-opening>
    <div class="cafe-hero-media">
      <EditorialImage src={cafeHero.src} alt={cafeHero.alt} width={cafeHero.width} height={cafeHero.height} loading="eager" fetchpriority="high" />
    </div>
    <div class="cafe-heading">
      <p class="eyebrow">КОФЕЙНЯ В РУЗЕ · ФЕДЕРАТИВНАЯ, 7</p>
      <h1>История<br /><em>места.</em></h1>
      <p>Кофе у окна, карта на стене и город за дверью.</p>
      <a class="text-link" href="#visit">Зайти в гости <ArrowMark direction="forward" /></a>
    </div>
  </header>

  <section class="section cafe-arrival">
    <div class="cafe-chapter" data-reveal>
      <p class="eyebrow">ВНУТРИ</p>
      <h2>Столик у окна</h2>
      <p>Днём свет с улицы ложится на столики у больших окон. Вечером с тротуара видно тёплый свет за стеклом. Здесь можно допить кофе перед прогулкой или вернуться после музея и разложить на столе открытки.</p>
    </div>
    <PhotoFrame photo={photo.cafeWindow} class="window-shot" />
    <PhotoFrame photo={photo.cafeFacade} class="facade-shot" />
  </section>

  <section class="cafe-table">
    <PhotoFrame photo={photo.cafeHands} caption={false} />
    <div class="cafe-chapter" data-reveal>
      <p class="eyebrow">ЗА СТОЛОМ</p>
      <h2>Кофе на двоих</h2>
      <p>Две чашки, розовые блюдца и стол, за которым хочется задержаться. У стойки — витрина с выпечкой. Если времени мало, берите чашку с собой и начните прогулку с площади Партизан.</p>
    </div>
  </section>

  <section class="section cafe-city">
    <div class="cafe-chapter" data-reveal>
      <p class="eyebrow">РУЗА НА СТЕНЕ</p>
      <h2>Город помещается на карте</h2>
      <p>На кирпичной стене — карта «Руза 1328». На полке — путеводители и местные сувениры. Рассмотрите, где проходит река и куда ведут улицы из центра. Потом можно проверить это пешком.</p>
      <a class="text-link" href="/routes/ruza-za-den/">Выйти на маршрут <ArrowMark direction="forward" /></a>
    </div>
    <PhotoFrame photo={photo.cafeMap} class="map-shot" />
    <PhotoFrame photo={photo.cafePastry} class="pastry-shot" />
    <PhotoFrame photo={photo.cafeGuide} class="guide-shot" />
  </section>

  <section class="section cafe-reviews" aria-labelledby="guest-notes">
    <header data-reveal>
      <p class="eyebrow">ГОСТИ КОФЕЙНИ</p>
      <h2 id="guest-notes">Что запоминают</h2>
    </header>
    {reviews.map(({ text, author }) => (
      <figure data-reveal>
        <blockquote>«{text}»</blockquote>
        <figcaption>{author} · Яндекс Карты</figcaption>
      </figure>
    ))}
    <a class="text-link" href={`${ruzaSources.cafe.url}reviews/`}>Читать отзывы <ArrowMark direction="diagonal" /></a>
  </section>

  <section class="section cafe-visit" id="visit">
    <div class="cafe-chapter" data-reveal>
      <p class="eyebrow">В ЦЕНТРЕ РУЗЫ</p>
      <h2>Увидимся на Федеративной</h2>
      <address>Московская область, Руза, Федеративная улица, 7</address>
      <p>Актуальные часы работы и контакты есть в карточке кофейни.</p>
      <div class="cafe-links">
        <a class="button button-filled" href={ruzaSources.cafe.url}>Открыть Яндекс Карты</a>
        <a class="text-link" href="/routes/ruza-za-den/">Начать прогулку отсюда</a>
      </div>
    </div>
    <PhotoFrame photo={photo.cafeCup} caption={false} />
  </section>
  <EditorialPath current="cafe" />
</BaseLayout>

<style>
  .cafe-opening { position: relative; isolation: isolate; display: grid; min-height: clamp(620px, 89svh, 1020px); align-items: end; padding: 140px 8vw clamp(60px, 9vw, 134px); }
  .cafe-hero-media { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: #302e22; }
  .cafe-hero-media :global(picture), .cafe-hero-media :global(img) { width: 100%; height: 100%; display: block; object-fit: cover; }
  .cafe-hero-media::after { position: absolute; inset: 0; content: ''; background: linear-gradient(90deg,#181813ed,#1818136e 52%,transparent 85%),linear-gradient(0deg,#181813b5,transparent 68%); }
  .cafe-heading { position: relative; }
  .cafe-heading h1 { font: 400 clamp(82px, 15vw, 222px)/.72 var(--editorial-serif); letter-spacing: -.065em; margin: 22px 0 26px; }
  .cafe-heading em { color: #e4c9aa; font-weight: 400; }
  .cafe-heading > p:not(.eyebrow) { color: #f1e8dc; font-size: clamp(17px, 2.1vw, 25px); }
  .cafe-heading .text-link { margin-top: 12px; }
  .cafe-arrival, .cafe-city { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; gap: clamp(18px, 3vw, 44px); }
  .cafe-arrival .cafe-chapter { grid-column: 1 / 6; grid-row: 1; align-self: center; }
  .cafe-arrival :global(.window-shot) { grid-column: 7 / 13; grid-row: 1 / 3; --photo-ratio: .82; }
  .cafe-arrival :global(.facade-shot) { grid-column: 1 / 7; grid-row: 2 / 4; --photo-ratio: 1.67; }
  .cafe-chapter h2, .cafe-reviews h2 { font: 400 clamp(37px, 5.7vw, 92px)/.93 var(--serif); letter-spacing: -.045em; margin: 15px 0 24px; }
  .cafe-chapter p:not(.eyebrow) { color: var(--muted); max-width: 47ch; line-height: 1.8; }
  .cafe-table { position: relative; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: center; gap: clamp(26px, 6vw, 100px); background: #2b3026; }
  .cafe-table :global(figure) { --photo-ratio: 1.35; }
  .cafe-table .cafe-chapter { padding: 40px 7vw 40px 0; }
  .cafe-city .cafe-chapter { grid-column: 1 / 7; align-self: center; }
  .cafe-city :global(.map-shot) { grid-column: 8 / 13; grid-row: 1 / 3; --photo-ratio: .78; }
  .cafe-city :global(.pastry-shot) { grid-column: 1 / 5; --photo-ratio: 1.1; }
  .cafe-city :global(.guide-shot) { grid-column: 5 / 8; grid-row: 2; margin-top: 32px; --photo-ratio: .78; }
  .cafe-reviews { display: grid; grid-template-columns: minmax(0,.85fr) repeat(2,minmax(0,1fr)); gap: 32px; background: #252b23; }
  .cafe-reviews h2 { font-size: clamp(36px, 4.1vw, 64px); }
  .cafe-reviews figure { margin: 0; border-top: 1px solid #d7c7b266; padding-top: 16px; }
  .cafe-reviews blockquote { margin: 0 0 18px; color: var(--stone); font: 400 clamp(25px, 3vw, 44px)/1.12 var(--serif); }
  .cafe-reviews figcaption { color: var(--muted); font-size: .9rem; }
  .cafe-reviews > a { grid-column: 2 / 4; justify-self: start; }
  .cafe-visit { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0,.55fr); gap: clamp(26px, 6vw, 96px); align-items: center; scroll-margin-top: 90px; }
  .cafe-visit :global(figure) { --photo-ratio: .96; }
  address { color: var(--stone); font-style: normal; }
  .cafe-links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 22px; }
  @media(max-width: 760px) {
    .cafe-opening { min-height: 78svh; padding: 140px 6vw 62px; }
    .cafe-hero-media :global(img) { object-position: 63% center; }
    .cafe-heading h1 { font-size: clamp(76px, 17vw, 120px); }
    .cafe-arrival, .cafe-city { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .cafe-arrival .cafe-chapter, .cafe-city .cafe-chapter { grid-column: 1 / -1; grid-row: auto; }
    .cafe-arrival :global(.window-shot, .facade-shot),
    .cafe-city :global(.map-shot, .pastry-shot, .guide-shot) { grid-column: auto; grid-row: auto; margin-top: 0; }
    .cafe-arrival :global(.facade-shot), .cafe-city :global(.map-shot) { grid-column: 1/-1; --photo-ratio: 1.42; }
    .cafe-arrival :global(.window-shot) { grid-column: 1/-1; --photo-ratio: 1.26; }
    .cafe-table, .cafe-visit, .cafe-reviews { grid-template-columns: minmax(0,1fr); }
    .cafe-table .cafe-chapter { padding: 0 6vw 45px; }
    .cafe-reviews > a { grid-column: auto; }
  }
</style>
