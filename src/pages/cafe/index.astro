---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { images, imageSrcSet } from '../../data';
---
<BaseLayout
  title="Кофейня — История места"
  description="Кофейное пространство как часть городской атмосферы, встреч и неспешных маршрутов."
>
  <PageIntro
    eyebrow="КОФЕЙНЫЙ ОПЫТ"
    title="Место для паузы."
    description="Иногда знакомство с городом начинается с чашки кофе и разговора, который не хочется заканчивать."
    image={images.cafe}
  />
  <section class="section intro-grid">
    <div>
      <p class="eyebrow">АТМОСФЕРА</p>
      <h2>Больше, чем кофе.</h2>
      <p>
        Кофейня в истории места — не просто точка на маршруте. Это пространство
        встреч, коротких остановок и маленьких ритуалов, из которых складывается
        ощущение города.
      </p>
      <a class="text-link" href="/cities/ruza/">Вернуться к атласу ↗</a>
    </div>
    <img src={images.coffee} srcset={imageSrcSet(images.coffee)} sizes="(max-width: 680px) 100vw, 50vw" alt="" loading="lazy" />
  </section>
  <section class="section cafe-note">
    <p class="eyebrow">МЕСТО ВСТРЕЧИ</p>
    <h2>Остановиться. Выдохнуть. Продолжить путь.</h2>
    <p>
      Здесь важны не только напитки, но и настроение пространства — свет,
      материалы, звук и люди вокруг. Детали кофейной истории будут дополняться
      по мере работы над проектом.
    </p>
  </section>
</BaseLayout>
