---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { images, hasLocalImage } from '../../data';
import { ruzaSources } from '../../content/ruza';

const hasInterior = hasLocalImage(images.cafe);
const hasCoffee = hasLocalImage(images.coffee);
---
<BaseLayout title="Кофейня «История места» в Рузе" description="Кофейня «История места» в Рузе, Федеративная улица, 7. Как добраться и куда пойти после кофе.">
  <PageIntro
    variant="cafe"
    edition="ФЕДЕРАТИВНАЯ, 7"
    eyebrow="КОФЕЙНЯ · РУЗА"
    title="История места"
    description="Кофейня на Федеративной улице, 7. Здесь можно встретиться перед прогулкой или остановиться после музея."
    image={hasInterior ? images.cafe : undefined}
  />
  <section class:list={['section cafe-visit', { 'has-photo': hasCoffee }]} id="visit">
    <div>
      <p class="eyebrow">КАК ЗАЙТИ</p>
      <h2>Кофе на Федеративной</h2>
      <address>Московская область, Руза, Федеративная улица, 7</address>
      <p>Актуальные часы работы и контакты смотрите в карточке кофейни.</p>
      <div class="cafe-links">
        <a class="button button-filled" href={ruzaSources.cafe.url}>Открыть Яндекс Карты</a>
        <a class="text-link" href="/routes/#ruza-za-den">Начать прогулку отсюда</a>
      </div>
    </div>
    {hasCoffee && (
      <figure>
        <EditorialImage src={images.coffee} alt="Две чашки кофе за общим столом" sizes="(max-width: 740px) 100vw, 50vw" />
        <figcaption>Кофе в «Истории места», Руза.</figcaption>
      </figure>
    )}
  </section>
  <EditorialPath current="cafe" />
</BaseLayout>

<style>
  .cafe-visit { padding-top: 0; }
  .has-photo { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 6vw, 84px); align-items: center; }
  h2 { margin: 12px 0 16px; font: 400 clamp(32px, 4.4vw, 60px)/1.04 var(--serif); }
  address { color: var(--stone); font-style: normal; }
  .cafe-visit p:not(.eyebrow), figcaption { color: var(--muted); }
  .cafe-links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 22px; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; aspect-ratio: 1.5; }
  figcaption { margin-top: 8px; font-size: .9rem; }
  @media(max-width: 740px) { .has-photo { grid-template-columns: 1fr; } }
</style>
