---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import ArrowMark from '../../components/ArrowMark.astro';
import { literaryNotes, ruzaStories } from '../../content/ruza';
---
<BaseLayout title="Истории Рузы — История места" description="Пять историй о Рузе. Городище, старые улицы, музей, река и городская жизнь.">
  <PageIntro eyebrow="РЕДАКЦИОННЫЙ ЖУРНАЛ · РУЗА" title="Истории Рузы" description="Пять историй о том, как менялся город и что можно увидеть в нём сегодня." />
  <section class="section journal-index" aria-label="Содержание">
    {ruzaStories.map((story) => (
      <a class="journal-row" href={`/stories/${story.slug}/`}>
        <span><strong>{story.title}</strong><small>{story.dek}</small></span>
        <ArrowMark direction="forward" />
      </a>
    ))}
  </section>
  <section class="section literary" id="literaturnye-okrestnosti">
    <p class="eyebrow">ЗА ПРЕДЕЛАМИ ГОРОДА</p>
    <h2>Литературные окрестности</h2>
    <dl>
      {literaryNotes.map(({ name, note, source }) => (
        <div><dt>{name}</dt><dd>{note} <a href={source.url}>Источник</a></dd></div>
      ))}
    </dl>
  </section>
  <EditorialPath current="stories" />
</BaseLayout>

<style>
  .journal-index { padding-top: 0; }
  .journal-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid #d7c7b244; padding: 24px 0; }
  .journal-row:first-child { border-top: 1px solid #d7c7b244; }
  .journal-row:is(:hover, :focus-visible) { color: var(--stone); }
  .journal-row strong { display: block; font: 400 clamp(22px, 3.1vw, 40px)/1.1 var(--serif); }
  .journal-row small { display: block; margin-top: 8px; color: var(--muted); font-size: .95rem; }
  .journal-row svg { flex: 0 0 18px; width: 18px; height: 18px; }
  .literary { padding-top: 0; }
  .literary h2 { margin: 12px 0 24px; font: 400 clamp(28px, 4vw, 50px)/1.1 var(--serif); }
  .literary dl { display: grid; gap: 20px; }
  .literary dt { color: var(--stone); }
  .literary dd { margin: 5px 0 0; color: var(--muted); }
  .literary a { color: var(--stone); text-decoration: underline; text-underline-offset: .22em; }
</style>
