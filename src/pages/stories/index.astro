---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import ArrowMark from '../../components/ArrowMark.astro';
import { literaryNotes, ruzaStories } from '../../content/ruza';
import { ruzaStoryImages } from '../../content/ruza-story-media';
import { ruzaMedia } from '../../content/ruza-media';
---
<BaseLayout title="Истории Рузы — История места" description="Семь историй о Рузе и окрестностях: от старого городища до Петрищева.">
  <PageIntro variant="journal" eyebrow="РЕДАКЦИОННЫЙ ЖУРНАЛ" edition="ПЕРВЫЙ ВЫПУСК" title="Истории Рузы и края" description="Городище, старые улицы, река и люди, которые собирают память о городе." image={ruzaMedia.square.src} />
  <section class="section journal" aria-label="Истории в выпуске">
    {ruzaStories.map((story) => (
      <article class="journal-story">
        <PhotoFrame photo={ruzaStoryImages[story.slug].cover} caption={false} />
        <div class="journal-copy">
          <h2><a href={`/stories/${story.slug}/`}>{story.title}</a></h2>
          <p>{story.dek}</p>
          <a class="text-link journal-cta" href={`/stories/${story.slug}/`} aria-label={`Читать: ${story.title}`}>Читать историю <ArrowMark direction="forward" /></a>
        </div>
      </article>
    ))}
  </section>
  <section class="section literary" id="literaturnye-okrestnosti">
    <p class="eyebrow">ЗА ПРЕДЕЛАМИ ГОРОДА</p>
    <h2>Литературные окрестности</h2>
    <dl>
      {literaryNotes.map(({ name, place, note }) => (
        <div><dt>{name}</dt><dd class="literary-place">{place}</dd><dd>{note}</dd></div>
      ))}
    </dl>
  </section>
  <EditorialPath current="stories" />
</BaseLayout>

<style>
  .journal { display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); row-gap: clamp(36px,6vw,90px); column-gap: clamp(16px,3vw,44px); }
  .journal-story { grid-column: span 6; min-width: 0; }
  .journal-story:first-child { grid-column: 1/-1; display: grid; grid-template-columns: minmax(0,1.4fr) minmax(0,.8fr); align-items: center; gap: clamp(22px,6vw,100px); }


  .journal-copy { padding-top: 22px; }
  .journal-copy h2 { margin: 0 0 9px; font: 400 clamp(27px,3.5vw,53px)/1.02 var(--serif); }
  .journal-story:first-child h2 { font-size: clamp(36px,5.4vw,82px); letter-spacing: -.04em; }
  .journal-copy h2 a:is(:hover,:focus-visible) { color: var(--stone); }
  .journal-copy p { max-width: 41ch; color: var(--muted); }
  .journal-cta { margin-top: 6px; }
  .literary { padding-top: 0; scroll-margin-top: 90px; }
  .literary h2 { margin: 12px 0 24px; font: 400 clamp(30px,4vw,58px)/1.1 var(--serif); }
  .literary dl { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%, 290px),1fr)); gap: 20px 36px; }
  .literary dl > div { padding: 16px 0; border-top: 1px solid #d7c7b244; }
  .literary .literary-place { color: var(--stone); font-size: .88rem; margin-block: 8px; }
  .literary dt { color: var(--stone); }
  .literary dd { margin: 5px 0 0; color: var(--muted); }
  @media(max-width:720px) {
    .journal { grid-template-columns: minmax(0,1fr); }
    .journal-story { grid-column: auto; }
    .journal-story:first-child { grid-template-columns: minmax(0,1fr); }
  }
</style>
