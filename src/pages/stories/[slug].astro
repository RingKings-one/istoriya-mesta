---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import PageIntro from '../../components/PageIntro.astro';
import { ruzaStories } from '../../content/ruza';
import { ruzaStoryImages } from '../../content/ruza-story-media';

export function getStaticPaths() {
  return ruzaStories.map((story) => ({
    params: { slug: story.slug },
    props: { story, media: ruzaStoryImages[story.slug] },
  }));
}

const { story, media } = Astro.props;
---
<BaseLayout title={`${story.title} — История места`} description={story.dek}>
  <PageIntro variant="journal" eyebrow="ИСТОРИИ · РУЗА" edition="ПЕРВЫЙ ВЫПУСК" title={story.title} description={story.dek} image={media.cover.src} />
  <article class="section story">
    <p class="story-caption">{media.cover.caption}</p>
    {story.sections.map(({ heading, body }, index) => (
      <>
        <section class="story-section" data-reveal><h2>{heading}</h2><p>{body}</p></section>
        {index === 0 && <PhotoFrame photo={media.detail} sizes="(max-width: 760px) 100vw, 900px" />}
      </>
    ))}
    <nav class="story-navigation" aria-label="Продолжить чтение">
      <a class="text-link" href={story.related.href}>{story.related.label}</a>
      <a class="text-link" href="/stories/">Все истории Рузы</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .story { max-width: 1100px; margin-inline: auto; padding-top: 26px; }
  .story-caption { margin: 0 0 clamp(44px, 8vw, 90px); color: var(--muted); font-size: .87rem; }
  .story-section { max-width: 760px; margin: 0 auto clamp(40px, 7vw, 82px); }
  .story-section h2 { margin: 0 0 16px; font: 400 clamp(29px, 5vw, 48px)/1.04 var(--serif); }
  .story-section p { max-width: 64ch; color: var(--stone); font-size: 1.06rem; line-height: 1.78; }
  .story :global(figure) { margin-bottom: clamp(50px, 8vw, 100px); }
  .story-navigation { max-width: 760px; margin-inline: auto; display: flex; gap: 18px 32px; flex-wrap: wrap; border-top: 1px solid #d7c7b244; padding-top: 24px; }
</style>
