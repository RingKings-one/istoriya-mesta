---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import { postcard } from '../../content/ruza';
import { ruzaMedia as photo } from '../../content/ruza-media';

const front = { ...postcard, caption: 'Лицевая сторона открытки. Начало XX века.' };
const records = [
  {
    id: 'plan-1784',
    era: '1784 · ПЛАН ГОРОДА',
    title: 'Руза, вычерченная заново',
    body: 'На листе видны прямые улицы и кварталы, собранные вокруг центра. Это проект регулярной планировки, утверждённый в 1784 году. Его проще читать вдвоём с современной картой: найти старую площадь, а затем проследить, как от неё расходятся улицы.',
    photo: photo.archiveMap,
  },
  {
    id: 'winter-cathedral',
    era: '1910–1914 · ОТКРЫТКА',
    title: 'Собор за зимними крышами',
    body: 'Из-за деревянных домов и занесённых снегом крыш поднимается колокольня Воскресенского собора. У такого дальнего ракурса есть своя ценность: видно, как собор выделялся над низкой городской застройкой.',
    photo: photo.archiveSnow,
  },
  {
    id: 'city-view',
    era: '1900–1910 · ВИД ГОРОДА',
    title: 'Улица под соборным холмом',
    body: 'Внизу стоят повозки, а по дороге между деревянными и каменными домами взгляд поднимается к собору. На этом снимке хорошо виден перепад высоты между улицей и храмом.',
    photo: photo.archiveTown,
  },
];
---
<BaseLayout title="Архив Рузы — История места" description="Открытки, исторические фотографии и план: Руза от XVIII века до начала XX века.">
  <PageIntro eyebrow="ВИЗУАЛЬНЫЙ АРХИВ · РУЗА" title="Архив Рузы" description="Лица города на старых открытках, фотографиях и картах." />
  <section class="section archive-feature" id="postcard">
    <PhotoFrame photo={front} priority />
    <div data-reveal>
      <p class="eyebrow">ОТКРЫТКА · {postcard.date}</p>
      <h2>{postcard.title}</h2>
      <p>У реки стояла земская библиотека-читальня с музеем местного края. На переднем плане — «гигантские шаги», старый парковый аттракцион: к высокому столбу крепились канаты, на которых раскачивались посетители.</p>
      <a class="text-link" href="/stories/muzey-kotoryy-sobiraet-pamyat/">Читать историю музея</a>
    </div>
    <details class="archive-back">
      <summary>Перевернуть открытку</summary>
      <PhotoFrame photo={photo.archiveBack} reveal={false} />
      <p>На обороте остались печатная разметка для адреса, рукописная пометка и музейный штамп.</p>
    </details>
  </section>

  <section class="section archive-collection" aria-labelledby="archive-title">
    <h2 id="archive-title">Город по кадрам</h2>
    <div class="archive-grid">
      {records.map((record) => (
        <article class="archive-record" id={record.id}>
          <PhotoFrame photo={record.photo} caption={false} />
          <div data-reveal>
            <p class="eyebrow">{record.era}</p>
            <h3>{record.title}</h3>
            <p>{record.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section archive-return">
    <div data-reveal>
      <p class="eyebrow">ИЗ АРХИВА НА УЛИЦУ</p>
      <h2>Выйти к собору</h2>
      <p>Посмотрите на сегодняшнюю площадь и попробуйте найти ракурс, в котором собор снова станет виден над линией крыш.</p>
      <a class="text-link" href="/routes/staraya-ruza/#sobor">Остановка у собора</a>
    </div>
    <PhotoFrame photo={photo.cathedral} />
  </section>
  <EditorialPath current="archive" />
</BaseLayout>

<style>
  .archive-feature, .archive-return { display: grid; grid-template-columns: minmax(0,1.45fr) minmax(0,.75fr); gap: clamp(22px, 6vw, 76px); align-items: center; padding-top: 0; scroll-margin-top: 98px; }
  .archive-feature > :global(figure), .archive-back > :global(figure), .archive-record :global(figure) { background: #302d23; padding: clamp(6px,1vw,15px); }
  h2 { margin: 12px 0 20px; font: 400 clamp(38px,5.7vw,86px)/.99 var(--serif); letter-spacing: -.03em; }
  .archive-feature p:not(.eyebrow), .archive-collection p:not(.eyebrow), .archive-return p:not(.eyebrow) { color: var(--muted); max-width: 58ch; }
  .archive-feature .text-link, .archive-return .text-link { margin-top: 14px; }
  .archive-back { grid-column: 1/-1; border-top: 1px solid #d7c7b244; padding-top: 15px; }
  .archive-back > summary { width: fit-content; cursor: pointer; color: var(--stone); }
  .archive-back > :global(figure) { max-width: 580px; margin-top: 18px; }
  .archive-collection { padding-top: 0; }
  .archive-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(24px,5vw,66px); }
  .archive-record:first-child { grid-column: 1/-1; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,.88fr); gap: clamp(22px,5vw,72px); align-items: center; }
  .archive-record :global(figure) { margin-bottom: 20px; }
  .archive-record h3 { margin: 10px 0 14px; font: 400 clamp(27px,3.2vw,50px)/1.04 var(--serif); }
  .archive-return { grid-template-columns: minmax(0,.7fr) minmax(0,1fr); }
  @media(max-width:740px) {
    .archive-feature, .archive-return, .archive-grid, .archive-record:first-child { grid-template-columns: minmax(0,1fr); }
    .archive-record:first-child { gap: 0; }
  }
</style>
