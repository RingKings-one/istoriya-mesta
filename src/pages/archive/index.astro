---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import PageIntro from '../../components/PageIntro.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import { postcard, ruzaSources } from '../../content/ruza';

const collections = [
  { title: 'План Рузы 1784 года', text: 'В материалах генерального плана округа можно рассмотреть историческую схему улиц и кварталов.', source: ruzaSources.plan },
  { title: 'Фотографии XX века', text: 'Рузский музей собрал на ретровыставке виды Городка, центральных улиц и купеческих домов середины XX века.', source: ruzaSources.exhibition },
  { title: 'Руза в годы войны', text: 'Музейная экспозиция об освобождении Рузского края включает фотографии города и окрестностей из фондов музея.', source: ruzaSources.memory },
];
---
<BaseLayout title="Архив Рузы — История места" description="Открытка начала XX века, исторический план города и источники по фотографиям Рузы.">
  <PageIntro eyebrow="ВИЗУАЛЬНЫЙ АРХИВ · РУЗА" title="Архив Рузы" description="Город на открытках, планах и фотографиях из музейных коллекций." />
  <section class="section archive-feature" id="postcard">
    <figure>
      <EditorialImage src={postcard.src} alt={postcard.alt} width={postcard.width} height={postcard.height} />
      <figcaption>{postcard.credit} <a href={postcard.rightsUrl}>{postcard.rights}</a>.</figcaption>
    </figure>
    <div>
      <p class="eyebrow">ОТКРЫТКА · {postcard.date}</p>
      <h2>{postcard.title}</h2>
      <p>На открытке видна земская библиотека-читальня, где работал музей местного края. За зданием изгибается Руза. Снимок позволяет увидеть, как музей и берег выглядели вместе в начале XX века.</p>
      <a class="text-link" href={ruzaSources.postcard.url}>Открыть карточку на Wikimedia Commons</a>
      <a class="text-link" href="/stories/muzey-kotoryy-sobiraet-pamyat/">Читать историю музея</a>
    </div>
  </section>
  <section class="section archive-collections" aria-labelledby="collections-title">
    <h2 id="collections-title">В коллекциях и публикациях</h2>
    <div class="archive-grid">
      {collections.map(({ title, text, source }) => (
        <article><h3>{title}</h3><p>{text}</p><a class="text-link" href={source.url}>{source.label}</a></article>
      ))}
    </div>
  </section>
  <EditorialPath current="archive" />
</BaseLayout>

<style>
  .archive-feature { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, .75fr); gap: clamp(26px, 6vw, 82px); align-items: center; padding-top: 0; scroll-margin-top: 100px; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; height: auto; }
  figcaption { margin-top: 10px; color: var(--muted); font-size: .9rem; }
  figcaption a { text-decoration: underline; }
  h2 { margin: 12px 0 18px; font: 400 clamp(30px, 4.2vw, 56px)/1.05 var(--serif); }
  article h3 { margin: 0 0 9px; font: 400 26px/1.1 var(--serif); }
  .archive-feature p:not(.eyebrow), article p { color: var(--muted); }
  .archive-feature .text-link { display: table; margin-top: 14px; }
  .archive-collections { padding-top: 0; }
  .archive-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 26px; }
  .archive-grid article { border-top: 1px solid #d7c7b244; padding-top: 18px; }
  @media(max-width: 740px) { .archive-feature { grid-template-columns: 1fr; } }
</style>
