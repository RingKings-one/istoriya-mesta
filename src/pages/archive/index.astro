---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import { images, imageSrcSet } from '../../data';
---
<BaseLayout
  title="Архив — История места"
  description="Визуальный архив проекта: фотографии, карты, предметы и другие следы времени."
>
  <PageIntro
    edition="АРХИВ · КОЛЛЕКЦИЯ 01"
    variant="archive"
    eyebrow="ВИЗУАЛЬНЫЙ АРХИВ · КОЛЛЕКЦИЯ 01"
    title="Память в деталях."
    description="Фотографии, документы, карты и предметы помогают увидеть место с разных сторон."
    image={images.archive}
  />
  <section class="archive-intro section">
    <p class="eyebrow">ПРИНЦИП АРХИВА</p>
    <h2>Не просто хранить — <em>сопоставлять.</em></h2>
    <p>Каждый материал должен иметь понятное происхождение и контекст. Коллекция будет пополняться проверенными фотографиями и источниками; временные редакционные изображения не являются историческими документами.</p>
  </section>
  <section class="archive-collection section">
    <div class="archive-heading"><p class="eyebrow">РАЗДЕЛЫ КОЛЛЕКЦИИ</p><span>01 / 03</span></div>
    <div class="archive-grid">
      <a class="archive-tile archive-tile-large" href="/stories/">
        <img src={images.camera} srcset={imageSrcSet(images.camera)} sizes="(max-width: 680px) 100vw, 58vw" alt="" loading="lazy" />
        <span class="archive-tile-overlay"></span>
        <span class="archive-tile-number">01</span>
        <span class="archive-tile-disclosure">ВРЕМЕННЫЙ ВИЗУАЛ</span>
        <span class="archive-tile-copy"><small>КАДРЫ И НАБЛЮДЕНИЯ</small><strong>Фотографическая память</strong><em>Перейти к историям ↗</em></span>
      </a>
      <a class="archive-tile" href="/routes/">
        <img src={images.map} srcset={imageSrcSet(images.map)} sizes="(max-width: 680px) 100vw, 42vw" alt="" loading="lazy" />
        <span class="archive-tile-overlay"></span>
        <span class="archive-tile-number">02</span>
        <span class="archive-tile-disclosure">ВРЕМЕННЫЙ ВИЗУАЛ</span>
        <span class="archive-tile-copy"><small>СХЕМЫ И ПРОСТРАНСТВО</small><strong>Карты и маршруты</strong><em>Исследовать ↗</em></span>
      </a>
      <a class="archive-tile" href="/cities/ruza/">
        <img src={images.books} srcset={imageSrcSet(images.books)} sizes="(max-width: 680px) 100vw, 42vw" alt="" loading="lazy" />
        <span class="archive-tile-overlay"></span>
        <span class="archive-tile-number">03</span>
        <span class="archive-tile-disclosure">ВРЕМЕННЫЙ ВИЗУАЛ</span>
        <span class="archive-tile-copy"><small>ИСТОЧНИКИ И СВИДЕТЕЛЬСТВА</small><strong>Материалы места</strong><em>Открыть главу ↗</em></span>
      </a>
    </div>
  </section>
  <EditorialPath current="archive" />
  <RelatedExplore entryId="archive" />\n</BaseLayout>

<style>
  .archive-intro { display:grid; grid-template-columns:.55fr 1fr 1fr; gap:30px; align-items:start; }
  .archive-intro h2 { margin:0; font:clamp(30px,4vw,54px)/1.04 var(--serif); font-weight:400; }
  .archive-intro h2 em { color:var(--stone); }
  .archive-intro > p:last-child { max-width:390px; margin:4px 0 0; color:var(--muted); }
  .archive-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:22px; }
  .archive-heading > span { color:var(--muted); font:14px var(--serif); }
  .archive-grid { display:grid; grid-template-columns:1.25fr 1fr; grid-template-rows:repeat(2,minmax(210px,1fr)); gap:14px; }
  .archive-tile { position:relative; min-width:0; min-height:230px; overflow:hidden; color:var(--light); background:var(--green); }
  .archive-tile-large { grid-row:span 2; min-height:470px; }
  .archive-tile img,.archive-tile-overlay { position:absolute; inset:0; width:100%; height:100%; }
  .archive-tile img { transition:transform .7s cubic-bezier(.2,.7,.2,1); }
  .archive-tile-overlay { background:linear-gradient(180deg,#11171312 15%,#111713d9 100%); }
  .archive-tile-number { position:absolute; top:18px; left:20px; color:#fff; font:22px var(--serif); }
  .archive-tile-disclosure { position:absolute; top:20px; right:20px; border:1px solid #e8e1d655; background:#181d1acc; padding:5px 7px; color:#e8e1d6; font-size:7px; letter-spacing:.1em; }
  .archive-tile-copy { position:absolute; right:22px; bottom:22px; left:22px; display:grid; gap:7px; }
  .archive-tile-copy small { color:#e8e1d6c9; font-size:9px; letter-spacing:.16em; }
  .archive-tile-copy strong { max-width:420px; font:clamp(22px,3vw,36px)/1.05 var(--serif); font-weight:400; }
  .archive-tile-copy em { margin-top:5px; color:var(--stone); font-size:10px; font-style:normal; }
  .archive-tile:hover img { transform:scale(1.035); }
  @media(max-width:760px) {
    .archive-intro { grid-template-columns:1fr; gap:14px; }
    .archive-intro h2 { max-width:460px; }
    .archive-grid { grid-template-columns:1fr 1fr; grid-template-rows:auto; }
    .archive-tile-large { grid-column:1/-1; grid-row:auto; min-height:340px; }
    .archive-tile { min-height:230px; }
  }
  @media(max-width:480px) {
    .archive-grid { grid-template-columns:1fr; }
    .archive-tile-large,.archive-tile { grid-column:auto; min-height:270px; }
  }
  @media(prefers-reduced-motion:reduce) { .archive-tile img { transition:none; } .archive-tile:hover img { transform:none; } }
</style>
