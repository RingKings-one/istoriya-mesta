---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EditorialPath from '../../components/EditorialPath.astro';
import { ruzaProfile } from '../../content';
import { postcard } from '../../content/ruza';
import FeatureCard from '../../components/FeatureCard.astro';
import { ruzaMedia as photo } from '../../content/ruza-media';
import EditorialImage from '../../components/EditorialImage.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';

const epochs = [
  { date: 'XIV век', title: 'Город на высоком берегу', text: 'Рузу упоминает грамота Ивана Калиты. В городе за точку отсчёта принимают 1328 год. Земляные валы Городка помогают увидеть, зачем укрепление устроили именно над речной долиной.', href: '/stories/gorod-kotoryy-pomnit/' },
  { date: '1784', title: 'Улицы по линейке', text: 'Для уездного города утвердили регулярный план. Его рисунок до сих пор читается от бывшей Торговой площади, где встречались горожане и жители соседних деревень.', href: '/stories/gorod-po-ulitsam/' },
  { date: '1906', title: 'День, когда городу понадобился музей', text: 'При библиотеке-читальне на берегу открылся музей местного края. Сейчас его коллекции можно увидеть на площади Партизан, а первое здание — на открытке в архиве.', href: '/archive/#postcard' },
  { date: '1942', title: 'Возвращение города к жизни', text: 'Рузу освободили 17 января. Военные фотографии хранятся в краеведческом музее, а на площади Партизан городской мемориал сохраняет имена погибших ружан.', href: '/archive/#war-memory' },
  { date: 'Сегодня', title: 'Исторический центр и город спорта', text: 'В Рузе сохранился старый центр, а в 2009 году открылся Дворец водных видов спорта. За городом начинается другой масштаб — деревни, храмы и Рузское водохранилище.', href: '/stories/ruza-segodnya/' },
];
---
<BaseLayout
  title="Руза — История места"
  description="Первая глава живого атласа «История места». Открываем Рузу через места, детали и маршруты."
>
  <PageIntro
    edition="АТЛАС · ГЛАВА 01 / РУЗА"
    variant="city"
    eyebrow="ПЕРВАЯ ГЛАВА · 01 / МОСКОВСКАЯ ОБЛАСТЬ"
    title="Руза · 1328"
    description="Небольшой город на высоком берегу. Здесь можно прочитать семь веков истории за одну прогулку."
    image={photo.wideCity.src}
  />
  <section class="ruza-opening section">
    <div class="ruza-opening-heading" data-reveal>
      <p class="eyebrow">ПОРТРЕТ МЕСТА</p>
      <h2>Начните с <em>высокого берега.</em></h2>
    </div>
    <div class="ruza-opening-copy" data-reveal>
      <p>{ruzaProfile.summary}</p>
      <p>Первый визит удобно начать с трёх ориентиров: площади Партизан, краеведческого музея и Городка. Они дают три разных вида на Рузу — с улицы, из архива и над рекой.</p>
      <span class="ruza-edition">АТЛАС ЖИВЫХ ИСТОРИЙ <i>—</i> ГЛАВА 01</span>
      <a class="text-link" href="/stories/gorod-kotoryy-pomnit/">Откуда начинается история Рузы</a>
    </div>
  </section>
  <section class="ruza-spread">
    <figure class="ruza-spread-image" data-reveal><EditorialImage src={photo.square.src} sizes="(max-width: 680px) 100vw, 68vw" alt={photo.square.alt} width={photo.square.width} height={photo.square.height} /><figcaption>{photo.square.caption}</figcaption></figure>
    <div class="ruza-spread-note" data-reveal>
      <span class="ruza-side-index">01 / 03</span>
      <p class="eyebrow">ПОЧУВСТВОВАТЬ</p>
      <h3>Увидеть знакомое<br />по-новому.</h3>
      <p>Город удобнее читать от площади Партизан. Здесь соседствуют собор, музей и старые торговые дома. От площади можно продолжить путь к Городку или свернуть на Федеративную за кофе.</p>
    </div>
  </section>
  <section class="section city-epochs" aria-labelledby="epochs-title">
    <div data-reveal>
      <p class="eyebrow">ГОРОД В РАЗНЫЕ ВЕКА</p>
      <h2 id="epochs-title">От крепости до города спорта</h2>
    </div>
    <ol>
      {epochs.map(({ date, title, text, href }) => (
        <li data-reveal><strong class="epoch-date">{date}</strong><div><h3>{title}</h3><p>{text}</p><a class="text-link" href={href}>Читать историю <span class="sr-only">«{title}»</span></a></div></li>
      ))}
    </ol>
  </section>
  <section class="section city-return">
    <PhotoFrame photo={photo.cafeHands} caption={false} />
    <div data-reveal>
      <p class="eyebrow">ФЕДЕРАТИВНАЯ, 7</p>
      <h2>Продолжите историю за чашкой кофе</h2>
      <p>На стене кофейни — карта Рузы. Найдите на ней места, которые уже увидели, и выберите следующую прогулку.</p>
      <a class="text-link" href="/cafe/">Зайти в «Историю места»</a>
    </div>
  </section>
  <section class="section ruza-directions">
    <div class="ruza-directions-heading" data-reveal><div><p class="eyebrow">КАРТА ИССЛЕДОВАНИЯ</p><h2>Выберите направление.</h2></div><p>Три способа приблизиться к характеру места</p></div>
    <div class="card-grid">
      <FeatureCard image={photo.park.src} eyebrow="В ДВИЖЕНИИ" title="Маршруты" text="Прогулки, которые помогают увидеть знакомое по-новому." href="/routes/" />
      <FeatureCard image={photo.museum.src} eyebrow="В ПАМЯТИ" title="Истории" text="Наблюдения, сюжеты и человеческие детали." href="/stories/" />
      <FeatureCard image={postcard.src} eyebrow="В ДЕТАЛЯХ" title="Архив" text="Визуальные материалы и следы времени." href="/archive/" />
    </div>
  </section>
  <EditorialPath current="ruza" />
</BaseLayout>

<style>
  .ruza-opening { display:grid; grid-template-columns:1fr .85fr; gap:clamp(30px,7vw,110px); align-items:end; }
  .ruza-opening-heading h2 { margin:14px 0 0; font:clamp(42px,6vw,82px)/.98 var(--serif); font-weight:400; }
  .ruza-opening-heading h2 em { color:var(--stone); }
  .ruza-opening-copy { max-width:440px; padding-bottom:5px; }
  .ruza-opening-copy > p { color:var(--muted); font-size:14px; }
  .ruza-opening-copy .text-link { display: inline-flex; margin-top: 16px; }
  .ruza-edition { display:flex; gap:10px; align-items:center; margin-top:28px; color:var(--stone); font-size:9px; letter-spacing:.14em; }
  .ruza-edition i { color:var(--rust); font-style:normal; }
  .ruza-spread { display:grid; grid-template-columns:1.4fr .6fr; gap:clamp(24px,5vw,70px); align-items:center; padding:0 6vw 90px; }
  .ruza-spread-image { margin:0; }
  .ruza-spread-image :global(img) { display:block; width:100%; height:auto; }
  .ruza-spread-image figcaption { padding-top:10px; color:var(--muted); font-size:8px; letter-spacing:.12em; }
  .ruza-spread-note { position:relative; padding:36px 0 36px 26px; border-left:1px solid #a8664b99; }
  .ruza-side-index { display:block; margin-bottom:34px; color:var(--rust); font:18px var(--serif); }
  .ruza-spread-note h3 { margin:12px 0; font:clamp(26px,3.3vw,44px)/1.08 var(--serif); font-weight:400; }
  .ruza-spread-note > p:last-child { color:var(--muted); font-size:11px; }
  .city-epochs, .city-return { display:grid; grid-template-columns: minmax(0,.75fr) minmax(0,1.25fr); gap: clamp(24px,7vw,100px); align-items:start; }
  .city-epochs h2, .city-return h2 { margin:13px 0; font:400 clamp(34px,5vw,67px)/1 var(--serif); }
  .city-epochs ol { margin:0; padding:0; list-style:none; }
  .city-epochs li { display:grid; grid-template-columns:minmax(74px,.3fr) minmax(0,1fr); gap:16px; border-top:1px solid #d7c7b244; padding:22px 0; }
  .city-epochs h3 { margin:0; font:400 clamp(24px,3vw,36px)/1.05 var(--serif); }
  .epoch-date { color:var(--stone); font:400 clamp(20px,3vw,32px)/1 var(--serif); }
  .city-epochs p:not(.eyebrow), .city-return p:not(.eyebrow) { color:var(--muted); }
  .city-return { align-items:center; padding-top:0; }
  .ruza-directions-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:26px; }
  .ruza-directions-heading h2 { margin:10px 0 0; font:clamp(30px,4vw,48px) var(--serif); font-weight:400; }
  .ruza-directions-heading > p { max-width:230px; color:var(--muted); font-size:11px; }
  @media(max-width:680px) {
    .city-epochs, .city-return { grid-template-columns: minmax(0,1fr); }
    .ruza-opening { grid-template-columns:1fr; gap:20px; }
    .ruza-spread { grid-template-columns:1fr; gap:22px; padding:0 6vw 64px; }
    .ruza-spread-note { padding:20px 0 20px 18px; }
    .ruza-side-index { margin-bottom:18px; }
    .ruza-directions-heading { align-items:flex-start; flex-direction:column; gap:4px; }
    .ruza-directions-heading > p { margin:0; }
  }
</style>
